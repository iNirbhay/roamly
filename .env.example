# Cloudinary Media Storage
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Access Token
MAP_TOKEN=your_mapbox_token

# Google OAuth 2.0 (Passport.js)
# Obtain these from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# Auth0 OAuth (Optional / Alternative - passport-auth0)
# Obtain these from: https://manage.auth0.com/
# Allowed Callback URL: http://localhost:8080/auth/auth0/callback
AUTH0_DOMAIN=your_tenant.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret
AUTH0_CALLBACK_URL=http://localhost:8080/auth/auth0/callback
