<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reservation Voucher &bull; <%= booking.bookingId %> &bull; Roamly</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/stylesheets/checkout.css">

    <style>
        :root {
            --roamly-navy: #0e1b2e;
            --roamly-forest: #245235;
            --roamly-cream: #f6f3eb;
            --roamly-sand: #eee8dc;
            --roamly-ochre: #d9822b;
            --roamly-border: #dcd4c3;
        }

        body {
            background-color: #f3f0e8;
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--roamly-navy);
            padding: 2.5rem 1rem;
        }

        .voucher-sheet {
            max-width: 820px;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 12px 40px rgba(14, 27, 46, 0.08);
            border: 1px solid var(--roamly-border);
            overflow: hidden;
        }

        .voucher-header {
            background: var(--roamly-navy);
            color: #ffffff;
            padding: 2.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
            border-bottom: 4px solid var(--roamly-ochre);
        }

        .voucher-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .voucher-logo-text i {
            color: var(--roamly-ochre);
        }

        .voucher-stamp-pill {
            background: rgba(36, 82, 53, 0.25);
            border: 2px solid #2ecc71;
            color: #2ecc71;
            padding: 0.5rem 1.25rem;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .voucher-body {
            padding: 2.5rem;
        }

        .voucher-section-title {
            font-size: 0.82rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--roamly-forest);
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .voucher-meta-box {
            background: var(--roamly-cream);
            border: 1px solid var(--roamly-border);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            margin-bottom: 2rem;
        }

        .voucher-qr-wrap {
            width: 110px;
            height: 110px;
            background: #ffffff;
            border: 1px solid var(--roamly-border);
            border-radius: 8px;
            padding: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        @media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
            }
            .voucher-sheet {
                box-shadow: none !important;
                border: 1px solid #ddd !important;
                max-width: 100% !important;
                border-radius: 0 !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <!-- TOP CONTROL BAR (HIDDEN IN PRINT) -->
    <div class="container mb-4 no-print text-center" style="max-width: 820px;">
        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-4 shadow-sm border">
            <a href="/bookings" class="roamly-btn-secondary py-2 px-3 text-decoration-none">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to My Bookings
            </a>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="roamly-btn-primary py-2 px-4">
                    <i class="fa-solid fa-print me-2"></i> Print / Save PDF
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN VOUCHER SHEET -->
    <div class="voucher-sheet">
        <!-- VOUCHER HEADER -->
        <header class="voucher-header">
            <div>
                <div class="voucher-logo-text">
                    <i class="fa-solid fa-compass"></i> ROAMLY
                </div>
                <div class="text-white-50 small mt-1">Official Curated Travel Reservation Voucher</div>
            </div>
            <div class="text-end">
                <div class="voucher-stamp-pill mb-1">
                    <i class="fa-solid fa-check-circle me-1"></i> PAID &bull; CONFIRMED
                </div>
                <div class="text-white-50 small">Demo Sandbox Gateway</div>
            </div>
        </header>

        <!-- VOUCHER BODY -->
        <div class="voucher-body">
            
            <!-- BOOKING IDENTIFIERS ROW -->
            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <span class="text-muted small d-block text-uppercase fw-bold">Confirmation Code</span>
                    <strong class="fs-4 text-navy"><%= booking.bookingId %></strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block text-uppercase fw-bold">Booking Date</span>
                    <strong><%= (booking.createdAt ? new Date(booking.createdAt) : new Date()).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %></strong>
                </div>
                <div class="col-sm-4">
                    <span class="text-muted small d-block text-uppercase fw-bold">Payment Status</span>
                    <span class="badge bg-success text-white">PAID IN FULL (DEMO)</span>
                </div>
            </div>

            <!-- SANCTUARY DETAILS BOX -->
            <div class="voucher-meta-box">
                <div class="voucher-section-title">
                    <i class="fa-solid fa-hotel"></i> Sanctuary &amp; Stay Details
                </div>
                <h3 class="font-serif fw-bold text-navy mb-1" style="font-size: 1.45rem;">
                    <%= booking.listing ? booking.listing.title : "Curated Roamly Sanctuary" %>
                </h3>
                <p class="text-muted mb-3">
                    <i class="fa-solid fa-location-dot text-forest me-1"></i>
                    <%= booking.listing ? booking.listing.location : "India" %>, <%= booking.listing && booking.listing.country ? booking.listing.country : "India" %>
                </p>

                <div class="row g-3 pt-3 border-top">
                    <div class="col-sm-4">
                        <span class="text-muted small d-block">Check-In</span>
                        <strong class="text-navy">
                            <%= booking.checkIn ? new Date(booking.checkIn).toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) : "Upcoming" %>
                        </strong>
                        <span class="text-muted small d-block">From 2:00 PM</span>
                    </div>
                    <div class="col-sm-4">
                        <span class="text-muted small d-block">Check-Out</span>
                        <strong class="text-navy">
                            <%= booking.checkOut ? new Date(booking.checkOut).toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) : "Upcoming" %>
                        </strong>
                        <span class="text-muted small d-block">Until 11:00 AM</span>
                    </div>
                    <div class="col-sm-4">
                        <span class="text-muted small d-block">Length &amp; Guests</span>
                        <strong class="text-navy">
                            <%= booking.nights || 1 %> Night<%= (booking.nights || 1) > 1 ? 's' : '' %>
                        </strong>
                        <span class="text-muted small d-block">
                            <%= booking.guests ? (booking.guests.total || 1) : 1 %> Traveler<%= (booking.guests && booking.guests.total > 1) ? 's' : '' %>
                        </span>
                    </div>
                </div>
            </div>

            <!-- GUEST & PAYMENT TWO-COLUMN ROW -->
            <div class="row g-4 mb-4">
                <div class="col-sm-6">
                    <div class="voucher-section-title">
                        <i class="fa-solid fa-user"></i> Primary Traveler
                    </div>
                    <div class="p-3 rounded-3 border bg-light">
                        <strong class="d-block text-navy fs-6 mb-1">
                            <%= booking.guestDetails ? booking.guestDetails.fullName : "Traveler" %>
                        </strong>
                        <div class="text-muted small">
                            <i class="fa-regular fa-envelope me-1"></i> <%= booking.guestDetails ? booking.guestDetails.email : "guest@roamly.com" %>
                        </div>
                        <div class="text-muted small">
                            <i class="fa-solid fa-phone me-1"></i> <%= booking.guestDetails ? booking.guestDetails.phone : "+91 98765 43210" %>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6">
                    <div class="voucher-section-title">
                        <i class="fa-solid fa-receipt"></i> Payment Receipt (Demo)
                    </div>
                    <div class="p-3 rounded-3 border bg-light">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Payment Method:</span>
                            <strong class="text-navy"><%= booking.payment ? booking.payment.method : "Demo Sandbox" %></strong>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Transaction ID:</span>
                            <code><%= booking.payment ? booking.payment.transactionId : "TXN-DEMO-001" %></code>
                        </div>
                        <div class="d-flex justify-content-between text-navy fw-bold border-top pt-2 mt-2">
                            <span>Total Amount Paid:</span>
                            <span class="text-forest fs-6">₹ <%= booking.pricing ? (booking.pricing.totalAmount || 0).toLocaleString("en-IN") : "0" %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHECK-IN INSTRUCTIONS & ARRIVAL QR CODE -->
            <div class="p-3 rounded-3 border d-flex justify-content-between align-items-center flex-wrap gap-3" style="background-color: #faf8f5;">
                <div>
                    <h6 class="fw-bold text-navy mb-1"><i class="fa-solid fa-key text-forest me-1"></i> Sanctuary Check-In Instructions</h6>
                    <ul class="text-muted small mb-0 ps-3">
                        <li>Present this voucher (printed or digital) alongside a valid Government Photo ID at the front desk.</li>
                        <li>Complimentary Roamly welcome amenities will be arranged upon arrival.</li>
                        <li>For late check-in coordination, contact the sanctuary concierge: <strong>concierge@roamly.travel</strong>.</li>
                    </ul>
                </div>
                <div class="text-center">
                    <div class="voucher-qr-wrap mx-auto mb-1">
                        <!-- SVG QR GRAPHIC -->
                        <svg viewBox="0 0 100 100" width="90" height="90" fill="#0e1b2e">
                            <rect width="100" height="100" fill="#ffffff"/>
                            <rect x="5" y="5" width="28" height="28" fill="#0e1b2e" rx="3"/>
                            <rect x="11" y="11" width="16" height="16" fill="#ffffff"/>
                            <rect x="15" y="15" width="8" height="8" fill="#245235"/>
                            <rect x="67" y="5" width="28" height="28" fill="#0e1b2e" rx="3"/>
                            <rect x="73" y="11" width="16" height="16" fill="#ffffff"/>
                            <rect x="77" y="15" width="8" height="8" fill="#245235"/>
                            <rect x="5" y="67" width="28" height="28" fill="#0e1b2e" rx="3"/>
                            <rect x="11" y="73" width="16" height="16" fill="#ffffff"/>
                            <rect x="15" y="77" width="8" height="8" fill="#245235"/>
                            <rect x="42" y="10" width="8" height="8"/>
                            <rect x="42" y="25" width="8" height="8" fill="#d9822b"/>
                            <rect x="15" y="42" width="8" height="8"/>
                            <rect x="42" y="42" width="16" height="16" fill="#245235" rx="2"/>
                            <rect x="68" y="42" width="8" height="8"/>
                            <rect x="42" y="68" width="8" height="8"/>
                            <rect x="68" y="68" width="18" height="18" fill="#0e1b2e"/>
                        </svg>
                    </div>
                    <span class="text-muted" style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase;">Check-in Pass</span>
                </div>
            </div>

            <!-- FOOTER NOTICE -->
            <div class="text-center text-muted small mt-4 pt-3 border-top">
                <span>Roamly Curated Stays &bull; Certified Sanctuary Partner &bull; Generated for Demo Purposes</span>
            </div>

        </div>
    </div>

</body>
</html>
