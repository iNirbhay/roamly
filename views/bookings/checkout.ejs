<% layout("layouts/boilerplate") %>

<link rel="stylesheet" href="/stylesheets/checkout.css">

<div class="roamly-editorial-page roamly-checkout-page" 
     id="checkoutRoot"
     data-listing-id="<%= listing._id %>"
     data-listing-title="<%= listing.title %>"
     data-listing-location="<%= listing.location %>, <%= listing.country %>"
     data-listing-image="<%= resolveListingImage(listing) %>"
     data-nightly-rate="<%= listing.price || 0 %>"
     data-user-id="<%= currUser ? currUser._id : '' %>">

    <!-- STEPPER PROGRESS -->
    <div class="checkout-stepper-wrap">
        <div class="checkout-stepper">
            <div class="stepper-step active" id="stepperStep1">
                <div class="stepper-num">1</div>
                <span>Trip &amp; Guests</span>
            </div>
            <div class="stepper-divider" id="stepperDiv1"></div>
            <div class="stepper-step" id="stepperStep2">
                <div class="stepper-num">2</div>
                <span>Demo Payment</span>
            </div>
            <div class="stepper-divider" id="stepperDiv2"></div>
            <div class="stepper-step" id="stepperStep3">
                <div class="stepper-num">3</div>
                <span>Confirmation</span>
            </div>
        </div>
    </div>

    <!-- 2-COLUMN CHECKOUT GRID -->
    <div class="checkout-layout-grid">
        
        <!-- LEFT COLUMN: STAGES -->
        <div class="checkout-flow-main">
            
            <!-- STAGE 1: TRIP & GUEST DETAILS -->
            <section class="checkout-stage-card" id="stageDetails">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="stage-title">Confirm &amp; Customize Your Stay</h2>
                    <span class="badge bg-light text-forest border py-2 px-3 fw-bold">Step 1 of 2</span>
                </div>
                <p class="stage-subtitle">
                    Verify your itinerary and add personalized services for your stay at <strong><%= listing.title %></strong>.
                </p>

                <!-- DEMO MODE NOTICE BANNER -->
                <div class="demo-mode-banner">
                    <div class="demo-banner-left">
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>DEMO MODE &bull; Simulated environment. No real funds or cards are charged.</span>
                    </div>
                    <span class="demo-badge-pill">Sandbox Active</span>
                </div>

                <form id="checkoutDetailsForm" novalidate>
                    <!-- TRIP DATES SELECTION -->
                    <div class="trip-summary-strip">
                        <div class="trip-meta-item">
                            <label class="trip-meta-label" for="checkInInput">Check-in Date</label>
                            <input type="date" class="form-control form-control-sm border-0 bg-transparent fw-bold p-0 text-navy" 
                                   id="checkInInput" 
                                   value="<%= queryData.checkIn %>" 
                                   required>
                        </div>
                        <div class="trip-meta-item">
                            <label class="trip-meta-label" for="checkOutInput">Check-out Date</label>
                            <input type="date" class="form-control form-control-sm border-0 bg-transparent fw-bold p-0 text-navy" 
                                   id="checkOutInput" 
                                   value="<%= queryData.checkOut %>" 
                                   required>
                        </div>
                    </div>

                    <!-- GUEST COUNTERS -->
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <div class="form-floating-custom">
                                <label for="adultsCountInput">Adults (Age 13+)</label>
                                <div class="input-wrapper">
                                    <i class="fa-solid fa-user-group input-leading-icon"></i>
                                    <select id="adultsCountInput" class="form-control-custom">
                                        <% for (let i = 1; i <= 8; i++) { %>
                                            <option value="<%= i %>" <%= queryData.adults === i ? 'selected' : '' %>><%= i %> <%= i === 1 ? 'Adult' : 'Adults' %></option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating-custom">
                                <label for="childrenCountInput">Children (Age 2–12)</label>
                                <div class="input-wrapper">
                                    <i class="fa-solid fa-child input-leading-icon"></i>
                                    <select id="childrenCountInput" class="form-control-custom">
                                        <% for (let i = 0; i <= 5; i++) { %>
                                            <option value="<%= i %>" <%= queryData.children === i ? 'selected' : '' %>><%= i %> Children</option>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CONTACT INFORMATION -->
                    <h4 class="fs-6 fw-bold text-navy mb-3">Primary Guest Details</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <div class="form-floating-custom">
                                <label for="guestFullName">Full Legal Name *</label>
                                <div class="input-wrapper">
                                    <i class="fa-regular fa-user input-leading-icon"></i>
                                    <input type="text" id="guestFullName" class="form-control-custom" 
                                           placeholder="e.g. Nirbhay Kaushik" 
                                           value="<%= currUser ? currUser.username : '' %>" 
                                           required>
                                </div>
                                <div class="field-error-msg" id="nameError">Please enter your full name.</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating-custom">
                                <label for="guestEmail">Email Address (For Booking Voucher) *</label>
                                <div class="input-wrapper">
                                    <i class="fa-regular fa-envelope input-leading-icon"></i>
                                    <input type="email" id="guestEmail" class="form-control-custom" 
                                           placeholder="traveler@roamly.com" 
                                           value="<%= currUser && currUser.email ? currUser.email : '' %>" 
                                           required>
                                </div>
                                <div class="field-error-msg" id="emailError">Please enter a valid email address.</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-floating-custom">
                                <label for="guestPhone">Contact Phone (+91) *</label>
                                <div class="input-wrapper">
                                    <i class="fa-solid fa-phone input-leading-icon"></i>
                                    <input type="tel" id="guestPhone" class="form-control-custom" 
                                           placeholder="98765 43210" 
                                           value="9876543210" 
                                           required>
                                </div>
                                <div class="field-error-msg" id="phoneError">Please provide a 10-digit mobile number.</div>
                            </div>
                        </div>
                    </div>

                    <!-- OPTIONAL CURATED ADD-ONS -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="fs-6 fw-bold text-navy mb-0">Curated Experiences &amp; Add-ons</h4>
                            <span class="text-muted small">Optional</span>
                        </div>
                        <p class="text-muted small mb-3">Elevate your stay with signature on-property experiences.</p>

                        <div class="addons-checklist">
                            <!-- Addon 1 -->
                            <label class="addon-card" id="addonCardBreakfast">
                                <div class="addon-left">
                                    <input type="checkbox" class="addon-checkbox" id="addonBreakfast" data-price="650" data-type="per_night">
                                    <div>
                                        <div class="addon-title">Farm-to-Table Organic Breakfast</div>
                                        <div class="addon-desc">Locally sourced seasonal breakfast buffet each morning</div>
                                    </div>
                                </div>
                                <div class="addon-price">+₹650 <span class="text-muted fw-normal small">/ night</span></div>
                            </label>

                            <!-- Addon 2 -->
                            <label class="addon-card" id="addonCardTransfer">
                                <div class="addon-left">
                                    <input type="checkbox" class="addon-checkbox" id="addonTransfer" data-price="1500" data-type="flat">
                                    <div>
                                        <div class="addon-title">Private Chauffeur Airport / Station Transfer</div>
                                        <div class="addon-desc">Seamless one-way pickup or drop-off in a premium sedan</div>
                                    </div>
                                </div>
                                <div class="addon-price">+₹1,500 <span class="text-muted fw-normal small">flat</span></div>
                            </label>

                            <!-- Addon 3 -->
                            <label class="addon-card" id="addonCardTour">
                                <div class="addon-left">
                                    <input type="checkbox" class="addon-checkbox" id="addonTour" data-price="850" data-type="per_guest">
                                    <div>
                                        <div class="addon-title">Heritage Walking Tour &amp; Sunset Tea</div>
                                        <div class="addon-desc">Curated local guide tour through nearby historic monuments</div>
                                    </div>
                                </div>
                                <div class="addon-price">+₹850 <span class="text-muted fw-normal small">/ guest</span></div>
                            </label>
                        </div>
                    </div>

                    <!-- CONTINUE BUTTON -->
                    <button type="button" class="roamly-btn-primary w-100 py-3 fs-6" id="proceedToPaymentBtn">
                        Proceed to Demo Payment <i class="fa-solid fa-arrow-right ms-2"></i>
                    </button>
                </form>
            </section>

            <!-- STAGE 2: DEMO PAYMENT GATEWAY -->
            <section class="checkout-stage-card" id="stagePayment" style="display: none;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h2 class="stage-title">Demo Payment Gateway</h2>
                    <span class="badge bg-light text-forest border py-2 px-3 fw-bold">Step 2 of 2</span>
                </div>
                <p class="stage-subtitle">
                    Select a demo payment method to simulate the transaction. This is a sandbox &mdash; no real money is transferred.
                </p>

                <!-- DEMO MODE NOTICE BANNER -->
                <div class="demo-mode-banner">
                    <div class="demo-banner-left">
                        <i class="fa-solid fa-flask-vial"></i>
                        <span>TEST GATEWAY &bull; Use instant autofill or test cards below.</span>
                    </div>
                    <span class="demo-badge-pill">Sandbox Active</span>
                </div>

                <!-- SIMULATED PAYMENT FAILURE ALERT -->
                <div class="payment-failure-alert" id="paymentFailureAlert">
                    <div class="failure-content">
                        <i class="fa-solid fa-circle-exclamation failure-icon"></i>
                        <div>
                            <strong class="d-block text-danger mb-1 fs-6">Payment Simulation Declined</strong>
                            <p class="mb-2 text-muted small" id="failureAlertMessage">
                                The card <strong>ending in 0002</strong> simulated an intentional authorization decline (Code: <code>ERR_DEMO_CARD_DECLINED</code>).
                            </p>
                            <button type="button" class="btn btn-sm btn-outline-danger fw-bold rounded-pill" id="tryAgainWithValidCardBtn">
                                <i class="fa-solid fa-rotate-left me-1"></i> Switch to Valid Test Card
                            </button>
                        </div>
                    </div>
                </div>

                <!-- PAYMENT METHOD TABS -->
                <div class="payment-tabs-bar" role="tablist">
                    <button type="button" class="payment-tab-btn active" data-tab="upi">
                        <i class="fa-solid fa-qrcode"></i> UPI / QR
                    </button>
                    <button type="button" class="payment-tab-btn" data-tab="cards">
                        <i class="fa-regular fa-credit-card"></i> Card
                    </button>
                    <button type="button" class="payment-tab-btn" data-tab="netbanking">
                        <i class="fa-solid fa-building-columns"></i> Net Banking
                    </button>
                    <button type="button" class="payment-tab-btn" data-tab="wallets">
                        <i class="fa-solid fa-wallet"></i> Wallets
                    </button>
                </div>

                <!-- 1. UPI PANEL -->
                <div class="payment-panel active" id="panel-upi">
                    <div class="upi-qr-box">
                        <div class="upi-qr-graphic">
                            <!-- SVG QR CODE SIMULATION -->
                            <svg class="upi-qr-svg" viewBox="0 0 100 100" fill="currentColor">
                                <rect width="100" height="100" fill="#ffffff"/>
                                <!-- Top-Left Corner -->
                                <rect x="5" y="5" width="30" height="30" fill="#0e1b2e" rx="4"/>
                                <rect x="11" y="11" width="18" height="18" fill="#ffffff" rx="2"/>
                                <rect x="15" y="15" width="10" height="10" fill="#245235" rx="1"/>
                                <!-- Top-Right Corner -->
                                <rect x="65" y="5" width="30" height="30" fill="#0e1b2e" rx="4"/>
                                <rect x="71" y="11" width="18" height="18" fill="#ffffff" rx="2"/>
                                <rect x="75" y="15" width="10" height="10" fill="#245235" rx="1"/>
                                <!-- Bottom-Left Corner -->
                                <rect x="5" y="65" width="30" height="30" fill="#0e1b2e" rx="4"/>
                                <rect x="11" y="71" width="18" height="18" fill="#ffffff" rx="2"/>
                                <rect x="15" y="75" width="10" height="10" fill="#245235" rx="1"/>
                                <!-- Random decorative QR pattern blocks -->
                                <rect x="42" y="10" width="8" height="8" fill="#0e1b2e"/>
                                <rect x="42" y="24" width="8" height="8" fill="#245235"/>
                                <rect x="12" y="42" width="8" height="8" fill="#0e1b2e"/>
                                <rect x="26" y="42" width="8" height="8" fill="#d9822b"/>
                                <rect x="42" y="42" width="16" height="16" fill="#0e1b2e" rx="2"/>
                                <rect x="65" y="42" width="10" height="10" fill="#245235"/>
                                <rect x="82" y="42" width="8" height="8" fill="#0e1b2e"/>
                                <rect x="42" y="65" width="10" height="10" fill="#d9822b"/>
                                <rect x="60" y="65" width="14" height="14" fill="#0e1b2e"/>
                                <rect x="80" y="65" width="12" height="12" fill="#245235"/>
                                <rect x="55" y="85" width="8" height="8" fill="#0e1b2e"/>
                                <rect x="72" y="85" width="16" height="8" fill="#245235"/>
                            </svg>
                        </div>
                        <div class="fw-bold text-navy mb-1">Scan QR Code with any UPI App</div>
                        <p class="text-muted small mb-2">Simulates Google Pay, PhonePe, Paytm, or BHIM</p>
                        <div class="upi-apps-icons">
                            <span class="upi-chip"><i class="fa-brands fa-google-pay text-primary me-1"></i> GPay</span>
                            <span class="upi-chip"><i class="fa-solid fa-mobile-screen-button text-purple me-1"></i> PhonePe</span>
                            <span class="upi-chip"><i class="fa-solid fa-wallet text-info me-1"></i> Paytm</span>
                            <span class="upi-chip"><i class="fa-solid fa-building-columns text-success me-1"></i> BHIM UPI</span>
                        </div>
                    </div>

                    <div class="text-center text-muted small mb-3">&mdash; OR ENTER UPI VPA &mdash;</div>
                    <div class="form-floating-custom mb-3">
                        <label for="upiIdInput">UPI Virtual Payment Address (VPA)</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-at input-leading-icon"></i>
                            <input type="text" id="upiIdInput" class="form-control-custom" placeholder="e.g. explorer@okhdfcbank" value="demo.traveler@upi">
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="text-muted small">Supports any valid demo VPA</span>
                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fa-solid fa-check me-1"></i> Verified Demo VPA</span>
                        </div>
                    </div>
                </div>

                <!-- 2. CARDS PANEL -->
                <div class="payment-panel" id="panel-cards">
                    <!-- TEST CARD SHORTCUTS -->
                    <div class="demo-card-actions">
                        <button type="button" class="demo-fill-btn" id="fillValidCardBtn">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> Auto-fill Valid Test Card
                        </button>
                        <button type="button" class="demo-fill-btn fail-btn" id="fillFailCardBtn">
                            <i class="fa-solid fa-triangle-exclamation"></i> Auto-fill Declining Card
                        </button>
                    </div>

                    <div class="form-floating-custom mb-3">
                        <label for="cardNumberInput">Card Number</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-credit-card input-leading-icon" id="cardBrandIcon"></i>
                            <input type="text" id="cardNumberInput" class="form-control-custom" 
                                   placeholder="4242 4242 4242 4242" 
                                   maxlength="19" 
                                   value="4242 4242 4242 4242">
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <span class="text-muted small">Standard test card pre-filled</span>
                            <span class="text-forest small fw-bold" id="cardBrandLabel"><i class="fa-brands fa-cc-visa me-1"></i> Visa Demo</span>
                        </div>
                    </div>

                    <div class="form-floating-custom mb-3">
                        <label for="cardHolderInput">Name on Card</label>
                        <div class="input-wrapper">
                            <i class="fa-regular fa-user input-leading-icon"></i>
                            <input type="text" id="cardHolderInput" class="form-control-custom" placeholder="Roamly Demo User" value="Roamly Demo User">
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <div class="form-floating-custom">
                                <label for="cardExpiryInput">Expiry Date</label>
                                <div class="input-wrapper">
                                    <i class="fa-regular fa-calendar input-leading-icon"></i>
                                    <input type="text" id="cardExpiryInput" class="form-control-custom" placeholder="MM/YY" maxlength="5" value="12/30">
                                </div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="form-floating-custom">
                                <label for="cardCvvInput">CVV / CVC</label>
                                <div class="input-wrapper">
                                    <i class="fa-solid fa-lock input-leading-icon"></i>
                                    <input type="password" id="cardCvvInput" class="form-control-custom" placeholder="123" maxlength="4" value="123">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. NET BANKING PANEL -->
                <div class="payment-panel" id="panel-netbanking">
                    <label class="form-label text-muted small fw-bold text-uppercase mb-2">Popular Indian Banks (Demo)</label>
                    <div class="banks-grid">
                        <div class="bank-choice-card selected" data-bank="HDFC Bank">
                            <div class="bank-initial-logo text-primary">HDFC</div>
                            <div class="bank-name-text">HDFC Bank</div>
                        </div>
                        <div class="bank-choice-card" data-bank="State Bank of India">
                            <div class="bank-initial-logo text-info">SBI</div>
                            <div class="bank-name-text">State Bank of India</div>
                        </div>
                        <div class="bank-choice-card" data-bank="ICICI Bank">
                            <div class="bank-initial-logo text-danger">ICICI</div>
                            <div class="bank-name-text">ICICI Bank</div>
                        </div>
                        <div class="bank-choice-card" data-bank="Axis Bank">
                            <div class="bank-initial-logo text-danger">AXIS</div>
                            <div class="bank-name-text">Axis Bank</div>
                        </div>
                        <div class="bank-choice-card" data-bank="Kotak Mahindra">
                            <div class="bank-initial-logo text-danger">KOTAK</div>
                            <div class="bank-name-text">Kotak Mahindra</div>
                        </div>
                        <div class="bank-choice-card" data-bank="Punjab National Bank">
                            <div class="bank-initial-logo text-warning">PNB</div>
                            <div class="bank-name-text">Punjab National</div>
                        </div>
                    </div>

                    <div class="form-floating-custom">
                        <label for="allBanksSelect">Or select from other banks</label>
                        <select id="allBanksSelect" class="form-control-custom">
                            <option value="">Choose your bank...</option>
                            <option value="Bank of Baroda">Bank of Baroda</option>
                            <option value="Canara Bank">Canara Bank</option>
                            <option value="IndusInd Bank">IndusInd Bank</option>
                            <option value="IDFC FIRST Bank">IDFC FIRST Bank</option>
                            <option value="Federal Bank">Federal Bank</option>
                            <option value="Yes Bank">Yes Bank</option>
                        </select>
                    </div>
                </div>

                <!-- 4. WALLETS PANEL -->
                <div class="payment-panel" id="panel-wallets">
                    <label class="form-label text-muted small fw-bold text-uppercase mb-2">Select Digital Wallet (Demo)</label>
                    <div class="wallets-list">
                        <div class="wallet-choice-item selected" data-wallet="Paytm Wallet">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-wallet text-info fs-5"></i>
                                <span class="fw-bold text-navy">Paytm Wallet</span>
                            </div>
                            <span class="badge bg-light text-forest border">Instant Demo Link</span>
                        </div>
                        <div class="wallet-choice-item" data-wallet="Amazon Pay">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-brands fa-amazon text-warning fs-5"></i>
                                <span class="fw-bold text-navy">Amazon Pay Balance</span>
                            </div>
                            <span class="badge bg-light text-forest border">Instant Demo Link</span>
                        </div>
                        <div class="wallet-choice-item" data-wallet="PhonePe Wallet">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-mobile-screen-button text-purple fs-5"></i>
                                <span class="fw-bold text-navy">PhonePe Wallet</span>
                            </div>
                            <span class="badge bg-light text-forest border">Instant Demo Link</span>
                        </div>
                        <div class="wallet-choice-item" data-wallet="MobiKwik">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-bolt text-primary fs-5"></i>
                                <span class="fw-bold text-navy">MobiKwik ZIP</span>
                            </div>
                            <span class="badge bg-light text-forest border">Instant Demo Link</span>
                        </div>
                    </div>
                </div>

                <!-- GATEWAY CTA BUTTONS -->
                <div class="mt-4 pt-2">
                    <button type="button" class="roamly-btn-primary w-100 py-3 fs-6 mb-2" id="submitPaymentBtn">
                        <i class="fa-solid fa-lock me-2"></i> Confirm Demo Reservation &bull; ₹<span id="btnPayAmount">0</span>
                    </button>
                    <button type="button" class="roamly-btn-secondary w-100 py-2 fs-6" id="backToDetailsBtn">
                        <i class="fa-solid fa-arrow-left me-2"></i> Back to Guest Details
                    </button>
                </div>

                <div class="text-center mt-3">
                    <span class="text-muted small">
                        <i class="fa-solid fa-shield-cat text-forest me-1"></i> 256-bit SSL Demo Encryption &bull; PCI-DSS Compliant Simulation
                    </span>
                </div>
            </section>

            <!-- STAGE 3: BOOKING CONFIRMATION SCREEN -->
            <section class="checkout-stage-card" id="stageConfirmation" style="display: none;">
                <div class="confirmation-success-card">
                    <div class="confirmation-badge-anim">
                        <i class="fa-solid fa-check"></i>
                    </div>
                    <h2 class="confirmation-title">Sanctuary Reserved!</h2>
                    <p class="confirmation-subtitle">
                        Your booking at <strong><%= listing.title %></strong> is officially confirmed. A copy of your reservation voucher is ready.
                    </p>

                    <!-- BOOKING ID PILL -->
                    <div class="booking-id-pill-box">
                        <div class="text-start">
                            <div class="booking-id-label">Confirmation Code</div>
                            <div class="booking-id-code" id="confirmedBookingId">ROAM-XXXXXX</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ms-2" id="copyBookingIdBtn" title="Copy code">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                    </div>

                    <!-- CONFIRMATION SUMMARY CARD -->
                    <div class="card border border-sand bg-cream-soft rounded-4 text-start p-4 mb-4" style="background-color: var(--roamly-cream);">
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Sanctuary</span>
                                <strong class="text-navy fs-6"><%= listing.title %></strong>
                                <span class="text-muted small d-block"><%= listing.location %>, <%= listing.country %></span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Primary Guest</span>
                                <strong class="text-navy fs-6" id="confirmGuestName">Traveler</strong>
                                <span class="text-muted small d-block" id="confirmGuestEmail">guest@roamly.com</span>
                            </div>
                            <div class="col-sm-6 border-top pt-2">
                                <span class="text-muted small d-block">Dates &amp; Duration</span>
                                <strong class="text-navy" id="confirmDates">Check-in to Check-out</strong>
                                <span class="text-muted small d-block" id="confirmNights">3 nights &bull; 2 guests</span>
                            </div>
                            <div class="col-sm-6 border-top pt-2">
                                <span class="text-muted small d-block">Total Paid (Demo)</span>
                                <strong class="text-forest fs-5" id="confirmTotalPaid">₹ 0</strong>
                                <span class="badge bg-success-subtle text-success border border-success-subtle mt-1">
                                    <i class="fa-solid fa-circle-check me-1"></i> PAID &bull; DEMO GATEWAY
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- ACTION BUTTONS -->
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                        <a href="#" class="roamly-btn-primary" id="confirmedVoucherLink" target="_blank">
                            <i class="fa-solid fa-print me-2"></i> Print Travel Voucher
                        </a>
                        <a href="/bookings" class="roamly-btn-secondary">
                            <i class="fa-solid fa-suitcase-rolling me-2"></i> View My Bookings
                        </a>
                    </div>
                    <div class="mt-3">
                        <a href="/listings" class="btn btn-link text-muted small text-decoration-none">
                            <i class="fa-solid fa-compass me-1"></i> Explore More Curated Sanctuaries
                        </a>
                    </div>
                </div>
            </section>
        </div>

        <!-- RIGHT COLUMN: STICKY PRICE SUMMARY CARD -->
        <aside class="checkout-summary-sticky">
            <div class="summary-card">
                <!-- LISTING MEDIA SUMMARY -->
                <div class="summary-media-row">
                    <img src="<%= resolveListingImage(listing) %>" 
                         alt="<%= listing.title %>" 
                         class="summary-img-thumb"
                         onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80';">
                    <div class="summary-details-col">
                        <h3 class="summary-listing-title"><%= listing.title %></h3>
                        <div class="summary-location-text">
                            <i class="fa-solid fa-location-dot"></i>
                            <span><%= listing.location %>, <%= listing.country %></span>
                        </div>
                        <div class="summary-rating-pill">
                            <i class="fa-solid fa-star"></i> 4.96 <span class="text-muted fw-normal">(Curated Stay)</span>
                        </div>
                    </div>
                </div>

                <!-- PRICE CALCULATION BREAKDOWN -->
                <div class="summary-pricing-body">
                    <div class="price-item-row">
                        <span>₹ <%= (listing.price || 0).toLocaleString("en-IN") %> &times; <span id="summaryNightsDisplay">3</span> nights</span>
                        <strong id="summaryBasePrice">₹ 0</strong>
                    </div>

                    <div class="price-item-row" id="summaryAddonsRow" style="display: none;">
                        <span>Curated add-ons</span>
                        <strong id="summaryAddonsPrice">₹ 0</strong>
                    </div>

                    <div class="price-item-row highlight">
                        <span>Roamly concierge booking service</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Free</span>
                    </div>

                    <div class="price-item-row">
                        <span>Sanctuary preservation &amp; GST (18%)</span>
                        <strong id="summaryTaxesPrice">₹ 0</strong>
                    </div>

                    <div class="price-divider-line"></div>

                    <div class="total-price-row">
                        <span class="total-label">Total Amount</span>
                        <span class="total-amount-display" id="summaryGrandTotal">₹ 0</span>
                    </div>
                    <div class="text-end text-muted small mt-1">Includes all applicable fees &amp; taxes</div>
                </div>

                <!-- TRUST & GUARANTEE BULLETS -->
                <div class="summary-trust-bullets">
                    <div class="trust-item">
                        <i class="fa-solid fa-arrow-rotate-left"></i>
                        <span>Free cancellation up to 48 hours prior to arrival</span>
                    </div>
                    <div class="trust-item">
                        <i class="fa-solid fa-award"></i>
                        <span>Verified sanctuary standards by Roamly curators</span>
                    </div>
                    <div class="trust-item">
                        <i class="fa-solid fa-shield-check"></i>
                        <span>Sandbox demo payment &mdash; 100% risk-free testing</span>
                    </div>
                </div>
            </div>
        </aside>

    </div>

</div>

<!-- SIMULATED PROCESSING OVERLAY -->
<div class="processing-overlay" id="processingOverlay" aria-hidden="true" role="dialog">
    <div class="processing-modal-card">
        <div class="processing-spinner-wrap">
            <div class="processing-ring"></div>
            <div class="processing-ring-inner"></div>
        </div>
        <h3 class="processing-title">Securing Your Sanctuary</h3>
        <p class="processing-subtext" id="processingStatusText">
            Simulating bank authorization with 256-bit demo encryption...
        </p>
    </div>
</div>

<script src="/js/checkout.js"></script>
