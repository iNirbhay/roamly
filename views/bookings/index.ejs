<% layout("layouts/boilerplate") %>

<link rel="stylesheet" href="/stylesheets/checkout.css">

<div class="roamly-editorial-page py-4">
    <!-- PAGE HEADER -->
    <header class="bookings-dashboard-header">
        <div class="explore-eyebrow mb-2">
            <span class="hero-dot"></span>
            <span>YOUR SANCTUARY RESERVATIONS</span>
        </div>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
            <div>
                <h1 class="explore-heading mb-2">My Bookings</h1>
                <p class="explore-subheading mb-0">
                    Review your confirmed upcoming sanctuaries, manage check-in dates, and revisit your travel history.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/listings" class="roamly-btn-secondary">
                    <i class="fa-solid fa-plus me-1"></i> Book Another Sanctuary
                </a>
            </div>
        </div>
    </header>

    <!-- SERVER-SIDE EMBEDDED BOOKINGS DATA -->
    <script id="serverBookingsData" type="application/json">
        <%- JSON.stringify(dbBookings || []) %>
    </script>

    <!-- FILTER TABS BAR -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div class="bookings-filter-bar" role="tablist">
            <button type="button" class="bookings-filter-btn active" id="tabFilterAll" data-filter="all">
                <i class="fa-solid fa-layer-group"></i> All Stays
                <span class="badge bg-cream text-navy rounded-pill px-2 border" id="countAll">0</span>
            </button>
            <button type="button" class="bookings-filter-btn" id="tabFilterUpcoming" data-filter="upcoming">
                <i class="fa-solid fa-plane-departure text-forest"></i> Upcoming
                <span class="badge bg-forest text-white rounded-pill px-2" id="countUpcoming">0</span>
            </button>
            <button type="button" class="bookings-filter-btn" id="tabFilterPast" data-filter="past">
                <i class="fa-solid fa-clock-rotate-left text-muted"></i> Previous
                <span class="badge bg-secondary text-white rounded-pill px-2" id="countPast">0</span>
            </button>
            <button type="button" class="bookings-filter-btn" id="tabFilterCancelled" data-filter="cancelled">
                <i class="fa-solid fa-ban text-danger"></i> Cancelled
                <span class="badge bg-danger text-white rounded-pill px-2" id="countCancelled">0</span>
            </button>
        </div>

        <div class="text-muted small">
            <i class="fa-solid fa-shield-check text-forest me-1"></i> Live Host Status &bull; Real-time Updates
        </div>
    </div>

    <!-- 1. UPCOMING BOOKINGS SECTION -->
    <section class="booking-section-wrapper mb-5" id="upcomingSection">
        <div class="bookings-section-header">
            <div>
                <h2 class="bookings-section-title">
                    <i class="fa-solid fa-plane-departure text-forest"></i>
                    Upcoming Bookings
                    <span class="badge bg-forest text-white rounded-pill fs-6 px-3 py-1 ms-2" id="upcomingHeaderBadge">0</span>
                </h2>
                <p class="text-muted small mb-0">Upcoming confirmed retreats waiting for your arrival</p>
            </div>
        </div>

        <div id="upcomingGrid" class="bookings-grid">
            <!-- Populated dynamically via JS -->
        </div>

        <div id="emptyUpcomingNotice" class="empty-section-card d-none">
            <i class="fa-solid fa-calendar-xmark fs-2 text-muted mb-2 d-block"></i>
            <h5 class="fw-bold text-navy mb-1">No Upcoming Stays Planned</h5>
            <p class="text-muted small mb-3">You don’t have any active or upcoming sanctuary reservations right now.</p>
            <a href="/listings" class="roamly-btn-primary px-3 py-2 text-decoration-none">
                <i class="fa-solid fa-compass me-1"></i> Explore Sanctuaries Across India
            </a>
        </div>
    </section>

    <!-- 2. PREVIOUS BOOKINGS SECTION -->
    <section class="booking-section-wrapper mb-5" id="pastSection">
        <div class="bookings-section-header pt-4 border-top">
            <div>
                <h2 class="bookings-section-title">
                    <i class="fa-solid fa-clock-rotate-left text-muted"></i>
                    Previous Bookings
                    <span class="badge bg-secondary text-white rounded-pill fs-6 px-3 py-1 ms-2" id="pastHeaderBadge">0</span>
                </h2>
                <p class="text-muted small mb-0">Past stays and completed journeys recorded on Roamly</p>
            </div>
        </div>

        <div id="pastGrid" class="bookings-grid">
            <!-- Populated dynamically via JS -->
        </div>

        <div id="emptyPastNotice" class="empty-section-card d-none">
            <i class="fa-solid fa-landmark-dome fs-2 text-muted mb-2 d-block"></i>
            <h5 class="fw-bold text-navy mb-1">No Previous Stays Recorded</h5>
            <p class="text-muted small mb-0">Your completed sanctuary trips will be archived here for easy rebooking.</p>
        </div>
    </section>

    <!-- 3. CANCELLED BOOKINGS SECTION -->
    <section class="booking-section-wrapper mb-5" id="cancelledSection">
        <div class="bookings-section-header pt-4 border-top">
            <div>
                <h2 class="bookings-section-title">
                    <i class="fa-solid fa-ban text-danger"></i>
                    Cancelled Reservations
                    <span class="badge bg-danger text-white rounded-pill fs-6 px-3 py-1 ms-2" id="cancelledHeaderBadge">0</span>
                </h2>
                <p class="text-muted small mb-0">Reservations cancelled by you or declined by sanctuary hosts</p>
            </div>
        </div>

        <div id="cancelledGrid" class="bookings-grid">
            <!-- Populated dynamically via JS -->
        </div>

        <div id="emptyCancelledNotice" class="empty-section-card d-none">
            <i class="fa-solid fa-calendar-check fs-2 text-muted mb-2 d-block"></i>
            <h5 class="fw-bold text-navy mb-1">No Cancelled Bookings</h5>
            <p class="text-muted small mb-0">None of your reservations have been cancelled.</p>
        </div>
    </section>

    <!-- GLOBAL EMPTY STATE (Shown only if user has 0 bookings total) -->
    <div id="globalEmptyState" class="text-center py-5 px-3 d-none">
        <div class="confirmation-badge-anim mb-4" style="background: var(--roamly-sand); color: var(--roamly-navy); box-shadow: none;">
            <i class="fa-solid fa-suitcase-rolling"></i>
        </div>
        <h3 class="stage-title mb-2">No bookings yet</h3>
        <p class="stage-subtitle mx-auto mb-4" style="max-width: 480px;">
            Start exploring Roamly and find your next stay.
        </p>
        <a href="/listings" class="roamly-btn-primary px-4 py-3">
            <i class="fa-solid fa-compass me-2"></i> Explore Properties
        </a>
    </div>
</div>

<!-- AUTHENTICATED USER ID METADATA -->
<meta id="authenticatedUserMeta" data-user-id="<%= currUser ? (currUser._id ? currUser._id.toString() : currUser.toString()) : '' %>">

<!-- BOOKING DETAILS MODAL -->
<div class="modal fade" id="bookingDetailModal" tabindex="-1" aria-labelledby="bookingDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom px-4 py-3" style="background-color: var(--roamly-cream);">
                <div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle mb-1" id="modalStatusPill">
                        <i class="fa-solid fa-circle-check me-1"></i> CONFIRMED &bull; DEMO
                    </span>
                    <h5 class="modal-title font-serif text-navy fw-bold" id="modalListingTitle">Sanctuary Details</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBookingBody">
                <!-- Populated dynamically via JS -->
            </div>
            <div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger d-none" id="modalCancelStayBtn">
                    <i class="fa-solid fa-ban me-1"></i> Cancel Reservation
                </button>
                <div class="d-flex gap-2 ms-auto">
                    <a href="#" id="modalPrintVoucherLink" target="_blank" class="roamly-btn-primary">
                        <i class="fa-solid fa-print me-2"></i> Print Official Voucher
                    </a>
                    <button type="button" class="roamly-btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CANCELLATION CONFIRMATION MODAL -->
<div class="modal fade" id="cancelBookingConfirmModal" tabindex="-1" aria-labelledby="cancelBookingConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-bottom px-4 py-3 bg-danger-subtle">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger text-white rounded-pill px-2 py-1">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </span>
                    <h5 class="modal-title font-serif text-navy fw-bold mb-0" id="cancelBookingConfirmModalLabel">Confirm Cancellation</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <h6 class="fw-bold text-navy mb-1" id="cancelListingTitle">Sanctuary Name</h6>
                    <div class="text-muted small">
                        Confirmation Code: <strong class="text-navy font-monospace" id="cancelBookingCode">ROAM-XXXXXX</strong>
                    </div>
                </div>

                <div class="p-3 rounded-3 mb-3 bg-light border">
                    <h6 class="text-uppercase fw-bold text-navy small mb-2">
                        <i class="fa-solid fa-calculator text-forest me-1"></i> Refund &amp; Charge Calculation
                    </h6>
                    <div class="d-flex justify-content-between text-muted small py-1 border-bottom">
                        <span>Original Paid Amount:</span>
                        <strong class="text-navy" id="cancelOriginalTotal">₹ 0</strong>
                    </div>
                    <div class="d-flex justify-content-between text-danger small py-1 border-bottom">
                        <span><i class="fa-solid fa-circle-minus me-1"></i> Cancellation Charge (15%):</span>
                        <strong id="cancelFeeAmount">- ₹ 0</strong>
                    </div>
                    <div class="d-flex justify-content-between text-forest fw-bold pt-2 fs-6">
                        <span><i class="fa-solid fa-circle-check me-1"></i> Net Refund to Process:</span>
                        <span id="cancelRefundAmount">₹ 0</span>
                    </div>
                </div>

                <div class="alert alert-warning d-flex align-items-start gap-2 py-2 px-3 mb-3" style="font-size: 0.85rem;">
                    <i class="fa-solid fa-shield-halved text-warning-emphasis fs-5 mt-1"></i>
                    <div>
                        <strong>Roamly Cancellation Policy:</strong>
                        A standard non-refundable 15% sanctuary administrative preservation fee is deducted. The remaining <strong>85% net refund</strong> will be returned to your original payment method immediately.
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold text-navy mb-1">Reason for cancellation:</label>
                    <select class="form-select form-select-sm" id="cancelReasonSelect">
                        <option value="Change of travel plans or dates">Change of travel plans or dates</option>
                        <option value="Found alternative accommodation">Found alternative accommodation</option>
                        <option value="Personal or family emergency">Personal or family emergency</option>
                        <option value="Booked by mistake">Booked by mistake</option>
                        <option value="Other reason">Other reason</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3 bg-light d-flex justify-content-between">
                <button type="button" class="roamly-btn-secondary py-2 px-3" data-bs-dismiss="modal">
                    Keep My Booking
                </button>
                <button type="button" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold" id="confirmCancelSubmitBtn">
                    <i class="fa-solid fa-ban me-1"></i> Cancel &amp; Confirm Refund
                </button>
            </div>
        </div>
    </div>
</div>

<!-- TOAST NOTIFICATION FOR CANCELLATION -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1090;">
    <div id="cancellationSuccessToast" class="toast align-items-center text-bg-success border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 text-white">
                <i class="fa-solid fa-circle-check fs-5"></i>
                <span id="toastMessage">Reservation cancelled successfully.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    // 0. Purge legacy global key to prevent cross-account contamination
    try {
        localStorage.removeItem("roamly_bookings");
    } catch (e) {}

    const authMeta = document.getElementById("authenticatedUserMeta");
    const currentUserId = authMeta ? authMeta.getAttribute("data-user-id") : "";

    // 1. Load Server Bookings (Pre-filtered by controllers/bookings.js to travelerId: req.user._id)
    const serverBookingsRaw = document.getElementById("serverBookingsData")?.textContent || "[]";
    let serverBookings = [];
    try {
        serverBookings = JSON.parse(serverBookingsRaw);
    } catch (e) {
        serverBookings = [];
    }

    // Defensive check: Ensure any loaded booking strictly matches currentUserId
    if (currentUserId) {
        serverBookings = serverBookings.filter(b => {
            const bUserId = b.travelerId ? (b.travelerId._id || b.travelerId) : (b.user ? (b.user._id || b.user) : null);
            return !bUserId || String(bUserId) === String(currentUserId);
        });
    }

    // 2. Load User-Scoped Local Bookings (Only from roamly_bookings_<userId>)
    let localBookings = [];
    if (currentUserId) {
        try {
            const scopedData = localStorage.getItem(`roamly_bookings_${currentUserId}`);
            if (scopedData) {
                const parsed = JSON.parse(scopedData);
                localBookings = parsed.filter(b => {
                    const bUserId = b.travelerId || b.userId || b.user;
                    return String(bUserId) === String(currentUserId);
                });
            }
        } catch (e) {
            localBookings = [];
        }
    }

    // Merge by unique bookingId
    const bookingMap = new Map();
    localBookings.forEach(b => {
        if (b && b.bookingId) bookingMap.set(b.bookingId, b);
    });
    serverBookings.forEach(b => {
        if (b && b.bookingId) bookingMap.set(b.bookingId, b);
    });

    let allBookings = Array.from(bookingMap.values());

    // Current active filter state
    let activeFilter = "all";

    // 2. Classify, calculate and render
    function recalculateAndRender() {
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const upcomingBookings = [];
        const pastBookings = [];
        const cancelledBookings = [];

        allBookings.forEach(b => {
            const rawStatus = (b.status || b.bookingStatus || "").toUpperCase();
            if (rawStatus === "CANCELLED") {
                cancelledBookings.push(b);
                return;
            }

            const checkOutDate = b.checkOut ? new Date(b.checkOut) : null;
            if (!checkOutDate || isNaN(checkOutDate.getTime())) {
                upcomingBookings.push(b);
                return;
            }

            // Include checkout day until 23:59:59 as upcoming/active
            const eodCheckout = new Date(checkOutDate);
            eodCheckout.setHours(23, 59, 59, 999);

            if (eodCheckout >= today) {
                upcomingBookings.push(b);
            } else {
                pastBookings.push(b);
            }
        });

        // Sort upcoming: soonest check-in first
        upcomingBookings.sort((a, b) => new Date(a.checkIn || 0) - new Date(b.checkIn || 0));

        // Sort past: most recent past stay first
        pastBookings.sort((a, b) => new Date(b.checkOut || 0) - new Date(a.checkOut || 0));

        // Sort cancelled: most recent first
        cancelledBookings.sort((a, b) => new Date(b.cancellation?.cancelledAt || b.updatedAt || b.createdAt || 0) - new Date(a.cancellation?.cancelledAt || a.updatedAt || a.createdAt || 0));

        // Update Counts
        const countAll = document.getElementById("countAll");
        const countUpcoming = document.getElementById("countUpcoming");
        const countPast = document.getElementById("countPast");
        const countCancelled = document.getElementById("countCancelled");
        const upcomingHeaderBadge = document.getElementById("upcomingHeaderBadge");
        const pastHeaderBadge = document.getElementById("pastHeaderBadge");
        const cancelledHeaderBadge = document.getElementById("cancelledHeaderBadge");

        if (countAll) countAll.textContent = allBookings.length;
        if (countUpcoming) countUpcoming.textContent = upcomingBookings.length;
        if (countPast) countPast.textContent = pastBookings.length;
        if (countCancelled) countCancelled.textContent = cancelledBookings.length;
        if (upcomingHeaderBadge) upcomingHeaderBadge.textContent = upcomingBookings.length;
        if (pastHeaderBadge) pastHeaderBadge.textContent = pastBookings.length;
        if (cancelledHeaderBadge) cancelledHeaderBadge.textContent = cancelledBookings.length;

        // Section Elements
        const upcomingSection = document.getElementById("upcomingSection");
        const pastSection = document.getElementById("pastSection");
        const cancelledSection = document.getElementById("cancelledSection");
        const upcomingGrid = document.getElementById("upcomingGrid");
        const pastGrid = document.getElementById("pastGrid");
        const cancelledGrid = document.getElementById("cancelledGrid");
        const emptyUpcomingNotice = document.getElementById("emptyUpcomingNotice");
        const emptyPastNotice = document.getElementById("emptyPastNotice");
        const emptyCancelledNotice = document.getElementById("emptyCancelledNotice");
        const globalEmptyState = document.getElementById("globalEmptyState");

        if (allBookings.length === 0) {
            if (upcomingSection) upcomingSection.classList.add("d-none");
            if (pastSection) pastSection.classList.add("d-none");
            if (cancelledSection) cancelledSection.classList.add("d-none");
            if (globalEmptyState) globalEmptyState.classList.remove("d-none");
            return;
        } else {
            if (globalEmptyState) globalEmptyState.classList.add("d-none");
        }

        // Helper: generate card HTML
        function createBookingCardHtml(booking, isPast, globalIndex) {
            const listing = booking.listing || {};
            const title = listing.title || "Curated Roamly Sanctuary";
            const location = listing.location ? (listing.location + (listing.country ? `, ${listing.country}` : '')) : "India";
            const listingId = listing._id || (typeof listing === "string" ? listing : "");

            let img = "https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80";
            if (typeof listing.image === "string") img = listing.image;
            else if (listing.image && listing.image.url) img = listing.image.url;
            else if (listing.imageUrl) img = listing.imageUrl;

            const checkInDate = booking.checkIn ? new Date(booking.checkIn) : new Date();
            const checkOutDate = booking.checkOut ? new Date(booking.checkOut) : new Date();

            const checkInStr = checkInDate.toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" });
            const checkOutStr = checkOutDate.toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" });
            const totalPaidNum = Number(booking.pricing?.totalAmount || booking.totalAmount || 0);
            const totalPaid = totalPaidNum.toLocaleString("en-IN");
            const nights = booking.nights || 1;
            const guestsCount = booking.guests ? (booking.guests.total || (booking.guests.adults || 1)) : 1;
            const roomsAllocated = booking.rooms || (booking.pricing && booking.pricing.rooms) || 1;
            const paymentMethod = (booking.payment && booking.payment.method) ? booking.payment.method : "Demo Gateway";
            const bookingCode = booking.bookingId || "ROAM-DEMO";

            // Dynamic Status and Timing Indicators
            const rawStatus = (booking.status || booking.bookingStatus || (isPast ? "COMPLETED" : "CONFIRMED")).toUpperCase();
            let statusBadge = "";
            let timingBadge = "";
            let cancellationNoticeHtml = "";

            if (rawStatus === "CANCELLED") {
                const cancelledBy = booking.cancellation?.cancelledBy || booking.cancelledBy || "host";
                const isCancelledByTraveler = cancelledBy === "traveler";
                const fee = booking.cancellation?.cancellationFee !== undefined ? booking.cancellation.cancellationFee : (isCancelledByTraveler ? Math.round(totalPaidNum * 0.15) : 0);
                const refund = booking.cancellation?.refundAmount !== undefined ? booking.cancellation.refundAmount : Math.max(0, totalPaidNum - fee);

                if (isCancelledByTraveler) {
                    statusBadge = `
                        <span class="booking-card-status-badge cancelled" style="background: rgba(220, 53, 69, 0.95); color: #ffffff;">
                            <i class="fa-solid fa-user-xmark me-1"></i> CANCELLED BY YOU
                        </span>
                    `;
                    timingBadge = `<span class="stay-duration-tag tag-past text-danger fw-semibold"><i class="fa-solid fa-rotate-left me-1"></i> Refund: ₹ ${refund.toLocaleString("en-IN")}</span>`;
                    cancellationNoticeHtml = `
                        <div class="p-2 rounded-2 mt-2 bg-light border border-danger-subtle text-muted small">
                            <div class="d-flex justify-content-between text-navy fw-semibold">
                                <span><i class="fa-solid fa-circle-check text-success me-1"></i> Refund Status:</span>
                                <span class="text-forest fw-bold">₹ ${refund.toLocaleString("en-IN")} Refunded</span>
                            </div>
                            <div class="d-flex justify-content-between text-muted" style="font-size: 0.78rem;">
                                <span>15% Cancellation Fee:</span>
                                <span class="text-danger">- ₹ ${fee.toLocaleString("en-IN")}</span>
                            </div>
                        </div>
                    `;
                } else {
                    statusBadge = `
                        <span class="booking-card-status-badge cancelled" style="background: rgba(220, 53, 69, 0.95); color: #ffffff;">
                            <i class="fa-solid fa-ban me-1"></i> CANCELLED BY HOST
                        </span>
                    `;
                    timingBadge = '<span class="stay-duration-tag tag-past text-danger fw-semibold"><i class="fa-solid fa-circle-xmark me-1"></i> Cancelled by Host</span>';
                    cancellationNoticeHtml = `
                        <div class="p-2 rounded-2 mt-2 bg-light border border-danger-subtle text-muted small">
                            <div class="d-flex justify-content-between text-navy fw-semibold">
                                <span><i class="fa-solid fa-circle-check text-success me-1"></i> Refund Status:</span>
                                <span class="text-forest fw-bold">₹ ${totalPaid} (100% Refunded)</span>
                            </div>
                        </div>
                    `;
                }
            } else if (rawStatus === "PENDING") {
                statusBadge = `
                    <span class="booking-card-status-badge pending" style="background: rgba(217, 130, 43, 0.95); color: #ffffff;">
                        <i class="fa-solid fa-clock me-1"></i> PENDING CONFIRMATION
                    </span>
                `;
                timingBadge = '<span class="stay-duration-tag tag-upcoming text-warning-emphasis"><i class="fa-solid fa-hourglass-half me-1"></i> Awaiting Host</span>';
            } else if (rawStatus === "CONFIRMED") {
                statusBadge = `
                    <span class="booking-card-status-badge upcoming" style="background: rgba(36, 82, 53, 0.95); color: #ffffff;">
                        <i class="fa-solid fa-circle-check me-1"></i> CONFIRMED
                    </span>
                `;
                if (!isPast) {
                    const diffDays = Math.ceil((checkInDate - today) / (1000 * 60 * 60 * 24));
                    if (diffDays <= 0 && checkOutDate >= today) {
                        timingBadge = '<span class="stay-duration-tag tag-upcoming text-forest"><i class="fa-solid fa-bell me-1"></i> Check-in Today</span>';
                    } else if (diffDays === 1) {
                        timingBadge = '<span class="stay-duration-tag tag-upcoming text-forest"><i class="fa-solid fa-clock me-1"></i> Check-in Tomorrow</span>';
                    } else if (diffDays > 1) {
                        timingBadge = `<span class="stay-duration-tag tag-upcoming text-forest"><i class="fa-solid fa-calendar-day me-1"></i> In ${diffDays} days</span>`;
                    }
                } else {
                    timingBadge = '<span class="stay-duration-tag tag-past"><i class="fa-solid fa-check-double me-1"></i> Completed Stay</span>';
                }
            } else {
                statusBadge = `
                    <span class="booking-card-status-badge past">
                        <i class="fa-solid fa-check-double me-1"></i> COMPLETED
                    </span>
                `;
                timingBadge = '<span class="stay-duration-tag tag-past"><i class="fa-solid fa-check-double me-1"></i> Completed Stay</span>';
            }

            const voucherUrl = `/bookings/${bookingCode}/voucher?name=${encodeURIComponent(booking.guestDetails?.fullName || 'Traveler')}&total=${booking.pricing?.totalAmount || 0}&listingTitle=${encodeURIComponent(title)}&location=${encodeURIComponent(location)}`;

            return `
                <article class="booking-history-card">
                    <div class="booking-card-media">
                        <img src="${img}" alt="${title}" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80';">
                        ${statusBadge}
                    </div>
                    <div class="booking-card-content">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="booking-code-pill">
                                <i class="fa-solid fa-hashtag text-forest"></i> ${bookingCode}
                            </span>
                            ${timingBadge}
                        </div>

                        <h3 class="booking-card-title">${title}</h3>
                        <div class="booking-card-location">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>${location}</span>
                        </div>

                        <div class="booking-card-meta-list">
                            <div class="d-flex justify-content-between">
                                <span><i class="fa-regular fa-calendar me-2 text-forest"></i> Dates:</span>
                                <strong class="text-navy">${checkInStr} &rarr; ${checkOutStr}</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span><i class="fa-solid fa-door-open me-2 text-forest"></i> Rooms &amp; Guests:</span>
                                <strong>${guestsCount} guest${guestsCount > 1 ? 's' : ''} &bull; <span class="text-forest">${roomsAllocated} room${roomsAllocated > 1 ? 's' : ''}</span> (${nights} night${nights > 1 ? 's' : ''})</strong>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span><i class="fa-solid fa-credit-card me-2 text-forest"></i> Total Paid:</span>
                                <strong class="text-forest">₹ ${totalPaid} <span class="fw-normal text-muted small">(${paymentMethod})</span></strong>
                            </div>
                            ${cancellationNoticeHtml}
                        </div>

                        <div class="booking-card-actions">
                            <button type="button" class="roamly-btn-secondary flex-grow-1 view-booking-details-btn" data-code="${bookingCode}">
                                <i class="fa-regular fa-eye me-1"></i> Details
                            </button>
                            <a href="${voucherUrl}" target="_blank" class="roamly-btn-primary flex-grow-1 ${rawStatus === 'CANCELLED' ? 'opacity-75' : ''}">
                                <i class="fa-solid fa-print me-1"></i> Voucher
                            </a>
                            ${(!isPast && rawStatus !== 'CANCELLED') ? `
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 trigger-cancel-booking-btn" data-code="${bookingCode}" title="Cancel this reservation">
                                    <i class="fa-solid fa-ban me-1"></i> Cancel
                                </button>
                            ` : ''}
                            ${(listingId) ? `
                                <a href="/listings/${listingId}" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="View or Rebook Sanctuary">
                                    <i class="fa-solid fa-rotate-right"></i>
                                </a>
                            ` : ''}
                        </div>
                    </div>
                </article>
            `;
        }

        // Render Upcoming Grid
        if (upcomingBookings.length > 0) {
            upcomingGrid.innerHTML = upcomingBookings.map((b, idx) => createBookingCardHtml(b, false, idx)).join("");
            if (emptyUpcomingNotice) emptyUpcomingNotice.classList.add("d-none");
        } else {
            if (upcomingGrid) upcomingGrid.innerHTML = "";
            if (emptyUpcomingNotice) emptyUpcomingNotice.classList.remove("d-none");
        }

        // Render Past Grid
        if (pastBookings.length > 0) {
            pastGrid.innerHTML = pastBookings.map((b, idx) => createBookingCardHtml(b, true, idx)).join("");
            if (emptyPastNotice) emptyPastNotice.classList.add("d-none");
        } else {
            if (pastGrid) pastGrid.innerHTML = "";
            if (emptyPastNotice) emptyPastNotice.classList.remove("d-none");
        }

        // Render Cancelled Grid
        if (cancelledGrid) {
            if (cancelledBookings.length > 0) {
                cancelledGrid.innerHTML = cancelledBookings.map((b, idx) => createBookingCardHtml(b, false, idx)).join("");
                if (emptyCancelledNotice) emptyCancelledNotice.classList.add("d-none");
            } else {
                cancelledGrid.innerHTML = "";
                if (emptyCancelledNotice) emptyCancelledNotice.classList.remove("d-none");
            }
        }

        // Apply Tab Filter Visibility
        if (activeFilter === "all") {
            if (upcomingSection) upcomingSection.style.display = "block";
            if (pastSection) pastSection.style.display = "block";
            if (cancelledSection) cancelledSection.style.display = (cancelledBookings.length > 0 ? "block" : "none");
        } else if (activeFilter === "upcoming") {
            if (upcomingSection) upcomingSection.style.display = "block";
            if (pastSection) pastSection.style.display = "none";
            if (cancelledSection) cancelledSection.style.display = "none";
        } else if (activeFilter === "past") {
            if (upcomingSection) upcomingSection.style.display = "none";
            if (pastSection) pastSection.style.display = "block";
            if (cancelledSection) cancelledSection.style.display = "none";
        } else if (activeFilter === "cancelled") {
            if (upcomingSection) upcomingSection.style.display = "none";
            if (pastSection) pastSection.style.display = "none";
            if (cancelledSection) cancelledSection.style.display = "block";
        }
    }

    // Initial calculation and render
    recalculateAndRender();

    // 3. Tab Filter Switching
    const filterBtns = document.querySelectorAll(".bookings-filter-btn");
    filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            filterBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            activeFilter = btn.dataset.filter || "all";
            recalculateAndRender();
        });
    });

    // 4. Modals & Handlers
    const detailModalEl = document.getElementById("bookingDetailModal");
    const detailModal = new bootstrap.Modal(detailModalEl);
    const modalTitle = document.getElementById("modalListingTitle");
    const modalBody = document.getElementById("modalBookingBody");
    const modalPrintVoucherLink = document.getElementById("modalPrintVoucherLink");
    const modalStatusPill = document.getElementById("modalStatusPill");
    const modalCancelStayBtn = document.getElementById("modalCancelStayBtn");

    const cancelModalEl = document.getElementById("cancelBookingConfirmModal");
    const cancelModal = new bootstrap.Modal(cancelModalEl);
    const cancelListingTitle = document.getElementById("cancelListingTitle");
    const cancelBookingCode = document.getElementById("cancelBookingCode");
    const cancelOriginalTotal = document.getElementById("cancelOriginalTotal");
    const cancelFeeAmount = document.getElementById("cancelFeeAmount");
    const cancelRefundAmount = document.getElementById("cancelRefundAmount");
    const confirmCancelSubmitBtn = document.getElementById("confirmCancelSubmitBtn");
    const cancelReasonSelect = document.getElementById("cancelReasonSelect");

    let currentCancellingBooking = null;

    function openCancellationModal(booking) {
        if (!booking) return;
        currentCancellingBooking = booking;

        const listing = booking.listing || {};
        const title = listing.title || "Curated Roamly Sanctuary";
        const total = Number(booking.pricing?.totalAmount || booking.totalAmount || 0);
        const fee = Math.round(total * 0.15);
        const refund = Math.max(0, total - fee);

        if (cancelListingTitle) cancelListingTitle.textContent = title;
        if (cancelBookingCode) cancelBookingCode.textContent = booking.bookingId || "ROAM-DEMO";
        if (cancelOriginalTotal) cancelOriginalTotal.textContent = `₹ ${total.toLocaleString("en-IN")}`;
        if (cancelFeeAmount) cancelFeeAmount.textContent = `- ₹ ${fee.toLocaleString("en-IN")}`;
        if (cancelRefundAmount) cancelRefundAmount.textContent = `₹ ${refund.toLocaleString("en-IN")}`;

        cancelModal.show();
    }

    // Details Modal Click Handler
    document.addEventListener("click", (e) => {
        const btn = e.target.closest(".view-booking-details-btn");
        if (!btn) return;

        const code = btn.dataset.code;
        const b = allBookings.find(item => item.bookingId === code);
        if (!b) return;

        const listing = b.listing || {};
        modalTitle.textContent = listing.title || "Sanctuary Details";

        const rawStatus = (b.status || b.bookingStatus || "CONFIRMED").toUpperCase();
        let modalStatusBadgeClass = "bg-success text-white";
        let modalStatusText = "PAID • CONFIRMED";
        let alertNotice = "";

        const totalPaid = Number(b.pricing?.totalAmount || b.totalAmount || 0);

        if (rawStatus === "CANCELLED") {
            const cancelledBy = b.cancellation?.cancelledBy || b.cancelledBy || "host";
            const isCancelledByTraveler = cancelledBy === "traveler";
            const fee = b.cancellation?.cancellationFee !== undefined ? b.cancellation.cancellationFee : (isCancelledByTraveler ? Math.round(totalPaid * 0.15) : 0);
            const refund = b.cancellation?.refundAmount !== undefined ? b.cancellation.refundAmount : Math.max(0, totalPaid - fee);

            if (isCancelledByTraveler) {
                modalStatusBadgeClass = "bg-danger text-white";
                modalStatusText = "CANCELLED BY YOU (REFUNDED)";
                alertNotice = `
                    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                        <i class="fa-solid fa-user-xmark me-2 fs-4"></i>
                        <div>
                            <strong>Reservation Cancelled by You:</strong> A 15% cancellation &amp; administrative fee of <strong>₹ ${fee.toLocaleString("en-IN")}</strong> was applied.
                            <div class="fw-bold text-success mt-1"><i class="fa-solid fa-circle-check me-1"></i> Net Refund: ₹ ${refund.toLocaleString("en-IN")} credited to demo payment method</div>
                        </div>
                    </div>
                `;
            } else {
                modalStatusBadgeClass = "bg-danger text-white";
                modalStatusText = "CANCELLED BY HOST";
                alertNotice = `
                    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                        <i class="fa-solid fa-ban me-2 fs-5"></i>
                        <div>
                            <strong>Notice:</strong> This booking request was cancelled or declined by the sanctuary host. 100% full refund was initiated.
                        </div>
                    </div>
                `;
            }
        } else if (rawStatus === "PENDING") {
            modalStatusBadgeClass = "bg-warning text-dark";
            modalStatusText = "PENDING HOST CONFIRMATION";
            alertNotice = `
                <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                    <i class="fa-solid fa-clock me-2 fs-5"></i>
                    <div>
                        <strong>Awaiting Host Confirmation:</strong> The host will verify and confirm your ticket shortly.
                    </div>
                </div>
            `;
        } else if (rawStatus === "COMPLETED") {
            modalStatusBadgeClass = "bg-secondary text-white";
            modalStatusText = "COMPLETED STAY";
        }

        if (modalStatusPill) {
            modalStatusPill.className = `badge ${modalStatusBadgeClass} py-2 px-3 mb-1`;
            modalStatusPill.innerHTML = `<i class="fa-solid fa-circle-info me-1"></i> ${modalStatusText}`;
        }

        // Toggle Cancel Button in Details Modal
        if (modalCancelStayBtn) {
            const checkOutDate = b.checkOut ? new Date(b.checkOut) : null;
            const isStayPast = checkOutDate && checkOutDate < new Date().setHours(0, 0, 0, 0);
            if (!isStayPast && rawStatus !== "CANCELLED") {
                modalCancelStayBtn.classList.remove("d-none");
                modalCancelStayBtn.dataset.code = b.bookingId;
            } else {
                modalCancelStayBtn.classList.add("d-none");
            }
        }

        const checkIn = b.checkIn ? new Date(b.checkIn).toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) : "-";
        const checkOut = b.checkOut ? new Date(b.checkOut).toLocaleDateString("en-IN", { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' }) : "-";
        const roomsAllocated = b.rooms || (b.pricing && b.pricing.rooms) || 1;
        const totalGuests = b.guests ? (b.guests.total || (b.guests.adults || 1)) : 1;

        let addonsHtml = "";
        if (b.addOns && b.addOns.length > 0) {
            addonsHtml = `
                <div class="mt-3">
                    <h6 class="fw-bold text-navy mb-2">Curated Add-ons:</h6>
                    <ul class="list-unstyled mb-0">
                        ${b.addOns.map(a => `<li class="d-flex justify-content-between text-muted small py-1 border-bottom"><span>${a.name} (${a.details || ''})</span> <strong>₹ ${(a.price || 0).toLocaleString("en-IN")}</strong></li>`).join("")}
                    </ul>
                </div>
            `;
        }

        modalBody.innerHTML = `
            ${alertNotice}

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label class="text-muted small d-block">Confirmation Code</label>
                    <strong class="text-navy fs-5 font-monospace">${b.bookingId}</strong>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <label class="text-muted small d-block">Status</label>
                    <span class="badge ${modalStatusBadgeClass} py-2 px-3">${modalStatusText}</span>
                </div>
            </div>

            <div class="p-3 rounded-3 mb-3" style="background-color: var(--roamly-cream); border: 1px solid var(--roamly-border);">
                <div class="row g-2 text-navy">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Check-in</span>
                        <strong>${checkIn}</strong> (from 2:00 PM)
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block">Check-out</span>
                        <strong>${checkOut}</strong> (until 11:00 AM)
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <h6 class="fw-bold text-navy mb-1">Accommodation &amp; Guests</h6>
                    <div class="text-navy fw-semibold">${roomsAllocated} Allocated Room${roomsAllocated > 1 ? 's' : ''}</div>
                    <div class="text-muted small">${totalGuests} Traveler${totalGuests > 1 ? 's' : ''} &bull; ${b.nights || 1} Night${(b.nights || 1) > 1 ? 's' : ''}</div>
                </div>
                <div class="col-sm-6">
                    <h6 class="fw-bold text-navy mb-1">Primary Traveler</h6>
                    <div class="text-muted small">${b.guestDetails?.fullName || 'Traveler'}</div>
                    <div class="text-muted small">${b.guestDetails?.email || '-'}</div>
                    <div class="text-muted small">${b.guestDetails?.phone || '-'}</div>
                </div>
            </div>

            <div class="row g-3 mb-3 border-top pt-3">
                <div class="col-sm-6">
                    <h6 class="fw-bold text-navy mb-1">Payment Method</h6>
                    <div class="text-muted small">${b.payment?.method || 'Demo Gateway'}</div>
                    <div class="text-muted small">Txn ID: <code>${b.payment?.transactionId || 'TXN-DEMO'}</code></div>
                </div>
                <div class="col-sm-6 text-sm-end">
                    <span class="fs-6 fw-bold text-navy d-block">Total Paid (Demo):</span>
                    <span class="fs-4 fw-bold text-forest">₹ ${totalPaid.toLocaleString("en-IN")}</span>
                </div>
            </div>

            ${addonsHtml}
        `;

        const location = listing.location ? (listing.location + (listing.country ? `, ${listing.country}` : '')) : "India";
        const voucherUrl = `/bookings/${b.bookingId}/voucher?name=${encodeURIComponent(b.guestDetails?.fullName || 'Traveler')}&total=${b.pricing?.totalAmount || 0}&listingTitle=${encodeURIComponent(listing.title || 'Sanctuary')}&location=${encodeURIComponent(location)}&rooms=${roomsAllocated}`;
        modalPrintVoucherLink.href = voucherUrl;

        detailModal.show();
    });

    // Trigger Cancel from Card
    document.addEventListener("click", (e) => {
        const cancelBtn = e.target.closest(".trigger-cancel-booking-btn");
        if (!cancelBtn) return;
        const code = cancelBtn.dataset.code;
        const b = allBookings.find(item => item.bookingId === code);
        if (b) {
            openCancellationModal(b);
        }
    });

    // Trigger Cancel from Details Modal Footer
    if (modalCancelStayBtn) {
        modalCancelStayBtn.addEventListener("click", () => {
            const code = modalCancelStayBtn.dataset.code;
            const b = allBookings.find(item => item.bookingId === code);
            if (b) {
                detailModal.hide();
                setTimeout(() => {
                    openCancellationModal(b);
                }, 350);
            }
        });
    }

    // Submit Cancellation Handler
    if (confirmCancelSubmitBtn) {
        confirmCancelSubmitBtn.addEventListener("click", async () => {
            if (!currentCancellingBooking) return;

            confirmCancelSubmitBtn.disabled = true;
            confirmCancelSubmitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Processing Cancellation...';

            const targetCode = currentCancellingBooking.bookingId;
            const total = Number(currentCancellingBooking.pricing?.totalAmount || currentCancellingBooking.totalAmount || 0);
            const fee = Math.round(total * 0.15);
            const refund = Math.max(0, total - fee);
            const reason = cancelReasonSelect ? cancelReasonSelect.value : "Cancelled by traveler";

            try {
                const res = await fetch(`/bookings/${targetCode}/cancel`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({ reason, isAjax: true })
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.message || "Failed to cancel reservation.");
                }

                // Hide confirmation modal
                cancelModal.hide();

                // Update booking in local memory
                const found = allBookings.find(item => item.bookingId === targetCode);
                if (found) {
                    found.status = "CANCELLED";
                    found.bookingStatus = "cancelled";
                    found.paymentStatus = "refunded";
                    found.cancellation = data.booking?.cancellation || {
                        cancelledBy: "traveler",
                        cancelledAt: new Date(),
                        cancellationFee: fee,
                        cancellationFeeRate: 0.15,
                        refundAmount: refund,
                        refundStatus: "refunded",
                        reason
                    };
                }

                // Sync user-scoped localStorage
                if (currentUserId) {
                    try {
                        const scopedKey = `roamly_bookings_${currentUserId}`;
                        const localData = JSON.parse(localStorage.getItem(scopedKey) || "[]");
                        const localItem = localData.find(item => item.bookingId === targetCode);
                        if (localItem) {
                            localItem.status = "CANCELLED";
                            localItem.bookingStatus = "cancelled";
                            localItem.paymentStatus = "refunded";
                            localItem.cancellation = found ? found.cancellation : null;
                        } else if (found) {
                            localData.push(found);
                        }
                        localStorage.setItem(scopedKey, JSON.stringify(localData));
                    } catch (storageErr) {
                        console.warn("Could not sync localStorage after cancellation:", storageErr);
                    }
                }

                // Re-calculate counts and re-render grids
                recalculateAndRender();

                // Display success toast
                const toastEl = document.getElementById("cancellationSuccessToast");
                if (toastEl) {
                    const msgEl = document.getElementById("toastMessage");
                    if (msgEl) {
                        msgEl.textContent = `Reservation ${targetCode} cancelled. ₹ ${fee.toLocaleString("en-IN")} fee deducted; ₹ ${refund.toLocaleString("en-IN")} refund processed.`;
                    }
                    const toast = new bootstrap.Toast(toastEl, { delay: 6000 });
                    toast.show();
                }
            } catch (err) {
                alert(err.message || "An error occurred while cancelling your reservation. Please try again.");
            } finally {
                confirmCancelSubmitBtn.disabled = false;
                confirmCancelSubmitBtn.innerHTML = '<i class="fa-solid fa-ban me-1"></i> Cancel &amp; Confirm Refund';
            }
        });
    }
});
</script>
