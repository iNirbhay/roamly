<% layout("layouts/boilerplate") %>

<div class="roamly-cinematic-home" id="cinematicExperience">

    <!-- Top Ambient Scroll Progress Bar -->
    <div class="scroll-progress-line" id="scrollProgressLine"></div>

    <!-- ==========================================================================
         HERO EXPERIENCE: Full-Screen Immersive Travel Scene
         - Layered depth/parallax
         - Logo reveal transforming into "Discover Stays That Feel Like Home"
         - Floating leaves, clouds, birds & map-route lines
         - Minimal floating search pill (Destination, Dates, Guests)
         - Scroll to explore interaction & smooth zoom transition
         ========================================================================== -->
    <section class="cinematic-hero-stage" id="heroStage">
        <!-- Parallax Background Landscape Layers -->
        <div class="hero-layer hero-layer-back" id="heroLayerBack"></div>
        <div class="hero-layer hero-layer-mid" id="heroLayerMid"></div>
        <div class="hero-layer hero-layer-mist" id="heroLayerMist"></div>
        <div class="hero-vignette-overlay"></div>

        <!-- Floating Natural Atmospheric Elements -->
        <div class="hero-floating-elements" aria-hidden="true">
            <!-- Gliding Birds -->
            <div class="ambient-bird bird-1">
                <svg viewBox="0 0 48 24" fill="none" class="bird-svg">
                    <path d="M2 18C10 8 18 10 24 16C30 10 38 8 46 18C38 12 30 14 24 20C18 14 10 12 2 18Z" fill="rgba(255,255,255,0.45)"/>
                </svg>
            </div>
            <div class="ambient-bird bird-2">
                <svg viewBox="0 0 48 24" fill="none" class="bird-svg">
                    <path d="M2 18C10 8 18 10 24 16C30 10 38 8 46 18C38 12 30 14 24 20C18 14 10 12 2 18Z" fill="rgba(255,255,255,0.3)"/>
                </svg>
            </div>

            <!-- Drifting Forest Leaves -->
            <div class="ambient-leaf leaf-1">
                <svg viewBox="0 0 32 32" fill="none" class="leaf-svg">
                    <path d="M16 2C8 6 4 14 6 22C8 30 18 30 24 24C30 18 28 8 16 2Z" fill="rgba(62, 111, 74, 0.4)"/>
                </svg>
            </div>
            <div class="ambient-leaf leaf-2">
                <svg viewBox="0 0 32 32" fill="none" class="leaf-svg">
                    <path d="M16 2C8 6 4 14 6 22C8 30 18 30 24 24C30 18 28 8 16 2Z" fill="rgba(229, 155, 56, 0.35)"/>
                </svg>
            </div>
            <div class="ambient-leaf leaf-3">
                <svg viewBox="0 0 32 32" fill="none" class="leaf-svg">
                    <path d="M16 2C8 6 4 14 6 22C8 30 18 30 24 24C30 18 28 8 16 2Z" fill="rgba(62, 111, 74, 0.25)"/>
                </svg>
            </div>

            <!-- Delicate Travel Map Route Lines -->
            <svg class="ambient-map-route" viewBox="0 0 1600 600" fill="none">
                <path d="M-100 450 C 300 250, 600 500, 1000 300 C 1200 200, 1400 320, 1600 280" stroke="rgba(250, 248, 245, 0.08)" stroke-width="2" stroke-dasharray="8 12" />
                <circle cx="1000" cy="300" r="5" fill="rgba(229, 155, 56, 0.6)" class="route-node" />
            </svg>
        </div>

        <!-- Hero Content Center Stage -->
        <div class="hero-stage-container">
            <!-- Brand Badge Reveal (Transforms on Load) -->
            <div class="hero-brand-morph-wrap" id="heroBrandMorph">
                <div class="hero-brand-logo-panel" id="heroLogoPanel">
                    <div class="hero-logo-pill-badge">
                        <img src="/images/roamly-logo-transparent.png" alt="Roamly" class="hero-morph-logo">
                    </div>
                    <span class="hero-morph-caption">Handcrafted Sanctuaries</span>
                </div>

                <div class="hero-headline-panel" id="heroHeadPanel">
                    <div class="hero-eyebrow-chip">
                        <span class="pulse-amber-dot"></span>
                        <span>Mindful Architecture &bull; Untouched Horizons</span>
                    </div>
                    <h1 class="hero-cinematic-title">
                        Discover Stays That<br>
                        <span class="hero-title-italic">Feel Like Home</span>
                    </h1>
                    <p class="hero-cinematic-sub">
                        Curated lakeside villas, secluded pine cabins, and heritage sanctuaries crafted for soulful travel.
                    </p>
                </div>
            </div>

            <!-- Minimal Floating Search Pill (Destination, Dates, Guests) -->
            <div class="hero-search-capsule-wrap" id="heroSearchCapsule">
                <form action="/listings" method="GET" class="hero-search-capsule" id="cinematicSearchForm">
                    <input type="hidden" name="checkIn" id="hiddenCheckIn" value="">
                    <input type="hidden" name="checkOut" id="hiddenCheckOut" value="">
                    <input type="hidden" name="guests" id="hiddenGuests" value="2">

                    <!-- Segment 1: Destination -->
                    <div class="search-seg search-seg-dest" id="segDestTrigger">
                        <div class="seg-icon-wrap">
                            <i class="fa-solid fa-compass"></i>
                        </div>
                        <div class="seg-inputs">
                            <label for="searchDestinationInput" class="seg-label">Destination</label>
                            <input 
                                type="text" 
                                id="searchDestinationInput" 
                                name="search" 
                                class="seg-field" 
                                placeholder="Where would you like to wander?" 
                                autocomplete="off"
                            >
                        </div>
                    </div>

                    <div class="search-seg-divider"></div>

                    <!-- Segment 2: Dates -->
                    <div class="search-seg search-seg-dates" id="segDatesTrigger">
                        <div class="seg-icon-wrap">
                            <i class="fa-regular fa-calendar"></i>
                        </div>
                        <div class="seg-inputs">
                            <span class="seg-label">Dates</span>
                            <span class="seg-display-text" id="datesDisplayText">Add flexible dates</span>
                        </div>
                    </div>

                    <div class="search-seg-divider"></div>

                    <!-- Segment 3: Guests -->
                    <div class="search-seg search-seg-guests" id="segGuestsTrigger">
                        <div class="seg-icon-wrap">
                            <i class="fa-regular fa-user"></i>
                        </div>
                        <div class="seg-inputs">
                            <span class="seg-label">Guests</span>
                            <span class="seg-display-text" id="guestsDisplayText">2 conscious travelers</span>
                        </div>
                    </div>

                    <!-- Search Trigger Button -->
                    <button type="submit" class="capsule-search-action-btn" aria-label="Search stays">
                        <i class="fa-solid fa-arrow-right"></i>
                        <span class="btn-text ms-1">Explore</span>
                    </button>
                </form>

                <!-- POPOVER 1: Destination Suggestions -->
                <div class="roamly-popover dest-popover d-none" id="destPopover">
                    <div class="popover-header">
                        <span class="popover-title"><i class="fa-solid fa-sparkles me-1"></i> Suggested Sanctuaries</span>
                        <span class="text-muted small">Quick Pick</span>
                    </div>
                    <div class="dest-suggestions-list">
                        <button type="button" class="dest-suggest-item" data-place="Udaipur">
                            <div class="suggest-icon-box"><i class="fa-solid fa-water"></i></div>
                            <div class="suggest-details">
                                <span class="place-name">Udaipur, Rajasthan</span>
                                <span class="place-tag">Lake Palaces &amp; Regal Courtyards</span>
                            </div>
                        </button>
                        <button type="button" class="dest-suggest-item" data-place="Goa">
                            <div class="suggest-icon-box"><i class="fa-solid fa-umbrella-beach"></i></div>
                            <div class="suggest-details">
                                <span class="place-name">Goa</span>
                                <span class="place-tag">Coastal Sanctuaries &amp; Golden Shores</span>
                            </div>
                        </button>
                        <button type="button" class="dest-suggest-item" data-place="Manali">
                            <div class="suggest-icon-box"><i class="fa-solid fa-mountain-sun"></i></div>
                            <div class="suggest-details">
                                <span class="place-name">Manali, Himachal</span>
                                <span class="place-tag">Cedar Chalets &amp; Pine Forests</span>
                            </div>
                        </button>
                        <button type="button" class="dest-suggest-item" data-place="Leh">
                            <div class="suggest-icon-box"><i class="fa-solid fa-mountain"></i></div>
                            <div class="suggest-details">
                                <span class="place-name">Leh, Ladakh</span>
                                <span class="place-tag">Starlit Dark Skies &amp; Mountain Passes</span>
                            </div>
                        </button>
                        <button type="button" class="dest-suggest-item" data-place="Munnar">
                            <div class="suggest-icon-box"><i class="fa-solid fa-leaf"></i></div>
                            <div class="suggest-details">
                                <span class="place-name">Munnar, Kerala</span>
                                <span class="place-tag">Emerald Tea Hills &amp; Mist</span>
                            </div>
                        </button>
                    </div>
                </div>

                <!-- POPOVER 2: Interactive Calendar -->
                <div class="roamly-popover calendar-popover d-none" id="calendarPopover">
                    <div class="cal-header-bar">
                        <button type="button" class="cal-nav-btn" id="calPrevBtn" aria-label="Previous Month">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <span class="cal-month-title" id="calMonthTitle">October 2026</span>
                        <button type="button" class="cal-nav-btn" id="calNextBtn" aria-label="Next Month">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    </div>
                    <div class="cal-weekdays">
                        <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
                    </div>
                    <div class="cal-days-grid" id="calDaysGrid">
                        <!-- Rendered dynamically -->
                    </div>
                    <div class="cal-shortcuts-row">
                        <button type="button" class="cal-shortcut-pill" id="shortcutWeekend">This Weekend</button>
                        <button type="button" class="cal-shortcut-pill" id="shortcutWeek">Next 7 Days</button>
                        <button type="button" class="cal-shortcut-pill" id="shortcutReset">Reset</button>
                    </div>
                    <div class="cal-footer-bar">
                        <span class="cal-summary-pill" id="calSummaryPill">Select check-in</span>
                        <button type="button" class="cal-done-btn" id="calDoneBtn">Apply Dates</button>
                    </div>
                </div>

                <!-- POPOVER 3: Guests Picker -->
                <div class="roamly-popover guests-popover d-none" id="guestsPopover">
                    <div class="popover-header">
                        <span class="popover-title"><i class="fa-solid fa-users me-1"></i> Mindful Travelers</span>
                    </div>
                    <div class="guest-row">
                        <div class="guest-meta">
                            <span class="guest-type">Adults</span>
                            <span class="guest-subtext">Ages 13 or above</span>
                        </div>
                        <div class="guest-counter">
                            <button type="button" class="counter-btn" id="btnAdultDec" aria-label="Decrease adults"><i class="fa-solid fa-minus"></i></button>
                            <span class="counter-num" id="valAdults">2</span>
                            <button type="button" class="counter-btn" id="btnAdultInc" aria-label="Increase adults"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="guest-row">
                        <div class="guest-meta">
                            <span class="guest-type">Children</span>
                            <span class="guest-subtext">Ages 2–12</span>
                        </div>
                        <div class="guest-counter">
                            <button type="button" class="counter-btn" id="btnChildDec" aria-label="Decrease children"><i class="fa-solid fa-minus"></i></button>
                            <span class="counter-num" id="valChildren">0</span>
                            <button type="button" class="counter-btn" id="btnChildInc" aria-label="Increase children"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="guest-row">
                        <div class="guest-meta">
                            <span class="guest-type">Infants</span>
                            <span class="guest-subtext">Under 2</span>
                        </div>
                        <div class="guest-counter">
                            <button type="button" class="counter-btn" id="btnInfantDec" aria-label="Decrease infants"><i class="fa-solid fa-minus"></i></button>
                            <span class="counter-num" id="valInfants">0</span>
                            <button type="button" class="counter-btn" id="btnInfantInc" aria-label="Increase infants"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="guests-footer">
                        <button type="button" class="cal-done-btn" id="guestsDoneBtn">Done</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll to Explore Interaction Prompt -->
        <a href="#categoriesSection" class="hero-scroll-prompt" id="heroScrollPrompt" aria-label="Scroll to explore sections below">
            <span class="scroll-prompt-text">Scroll to explore</span>
            <div class="scroll-mouse-icon">
                <div class="scroll-wheel"></div>
            </div>
            <i class="fa-solid fa-chevron-down scroll-arrow-icon"></i>
        </a>
    </section>

    <!-- Content Narrative Wrapper (Progressive Reveals) -->
    <main class="cinematic-narrative-flow">

        <!-- ==========================================================================
             SECTION 1: TRAVEL CATEGORIES WITH CUSTOM ILLUSTRATED ICONS
             ========================================================================== -->
        <section class="cinematic-section categories-reveal-section" id="categoriesSection">
            <div class="editorial-container">
                <div class="section-editorial-header text-center reveal-item">
                    <span class="editorial-tag"><i class="fa-solid fa-sparkles me-1"></i> Curated Landscapes</span>
                    <h2 class="editorial-heading anim-text-split">
                        <span class="word-reveal">Explore</span> 
                        <span class="word-reveal">Stays</span> 
                        <span class="word-reveal">by</span> 
                        <span class="word-reveal text-accent-gradient">Spirit &amp; Setting</span>
                    </h2>
                    <p class="editorial-subheading anim-subheading-reveal">
                        Whether you crave high-altitude alpine silence or rhythmic coastal tides, find stays that align with your pace.
                    </p>
                </div>

                <!-- Custom Illustrated Category Grid with Staggered Cascades -->
                <div class="illustrated-category-grid reveal-stagger-group">
                    <!-- 1. Trending -->
                    <a href="/listings?category=trending" class="category-curated-card anim-stagger-card" style="--stagger-idx: 0;">
                        <div class="cat-icon-badge badge-trending">
                            <i class="fa-solid fa-arrow-trend-up"></i>
                        </div>
                        <span class="cat-card-title">Trending</span>
                        <span class="cat-card-desc">Most loved sanctuaries</span>
                    </a>

                    <!-- 2. Cabins -->
                    <a href="/listings?category=cabins" class="category-curated-card anim-stagger-card" style="--stagger-idx: 1;">
                        <div class="cat-icon-badge badge-cabins">
                            <i class="fa-solid fa-house-chimney-window"></i>
                        </div>
                        <span class="cat-card-title">Cabins</span>
                        <span class="cat-card-desc">Wood &amp; cedar retreats</span>
                    </a>

                    <!-- 3. Beachfront -->
                    <a href="/listings?category=beachfront" class="category-curated-card anim-stagger-card" style="--stagger-idx: 2;">
                        <div class="cat-icon-badge badge-beach">
                            <i class="fa-solid fa-umbrella-beach"></i>
                        </div>
                        <span class="cat-card-title">Beachfront</span>
                        <span class="cat-card-desc">Ocean horizons &amp; tides</span>
                    </a>

                    <!-- 4. Mountains -->
                    <a href="/listings?category=mountains" class="category-curated-card anim-stagger-card" style="--stagger-idx: 3;">
                        <div class="cat-icon-badge badge-mountains">
                            <i class="fa-solid fa-mountain-sun"></i>
                        </div>
                        <span class="cat-card-title">Mountains</span>
                        <span class="cat-card-desc">High altitude escapes</span>
                    </a>

                    <!-- 5. Countryside -->
                    <a href="/listings?category=countryside" class="category-curated-card anim-stagger-card" style="--stagger-idx: 4;">
                        <div class="cat-icon-badge badge-countryside">
                            <i class="fa-solid fa-wheat-awn"></i>
                        </div>
                        <span class="cat-card-title">Countryside</span>
                        <span class="cat-card-desc">Pastoral valleys &amp; farms</span>
                    </a>

                    <!-- 6. City Stays -->
                    <a href="/listings?category=city" class="category-curated-card anim-stagger-card" style="--stagger-idx: 5;">
                        <div class="cat-icon-badge badge-city">
                            <i class="fa-solid fa-city"></i>
                        </div>
                        <span class="cat-card-title">City Stays</span>
                        <span class="cat-card-desc">Architectural town lofts</span>
                    </a>

                    <!-- 7. Unique Homes -->
                    <a href="/listings?category=unique" class="category-curated-card anim-stagger-card" style="--stagger-idx: 6;">
                        <div class="cat-icon-badge badge-unique">
                            <i class="fa-solid fa-wand-magic-sparkles"></i>
                        </div>
                        <span class="cat-card-title">Unique Homes</span>
                        <span class="cat-card-desc">Treehouses &amp; stone forts</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- ==========================================================================
             SECTION 2: POPULAR DESTINATIONS SHOWCASE (Only 4-5 Curated Destinations)
             ========================================================================== -->
        <section class="cinematic-section destinations-showcase-section" id="destinationsSection">
            <div class="editorial-container">
                <div class="destinations-header-row reveal-item">
                    <div>
                        <span class="editorial-tag"><i class="fa-solid fa-compass me-1"></i> Iconic Escapes</span>
                        <h2 class="editorial-heading anim-text-split">
                            <span class="word-reveal">Popular</span> 
                            <span class="word-reveal text-accent-gradient">Destinations</span>
                        </h2>
                        <p class="editorial-subheading anim-subheading-reveal">
                            Five regional tapestries where heritage, landscape, and serene architecture converge.
                        </p>
                    </div>
                    <div class="destinations-swipe-indicator d-none d-md-flex align-items-center gap-2">
                        <span class="text-muted small">Explore regions</span>
                        <i class="fa-solid fa-arrow-right-long text-muted"></i>
                    </div>
                </div>

                <!-- 5 Curated Destinations Carousel / Grid with Staggered Waves & Parallax -->
                <div class="destinations-showcase-track reveal-stagger-group">
                    <!-- Dest 1: Udaipur -->
                    <a href="/listings?search=Udaipur" class="dest-showcase-card anim-stagger-card" style="--stagger-idx: 0;">
                        <div class="dest-card-media">
                            <img 
                                src="https://images.unsplash.com/photo-1599661046289-e31897846e41?auto=format&fit=crop&w=800&q=85" 
                                alt="Udaipur Lake Palaces" 
                                loading="lazy"
                                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80';"
                                class="parallax-media-img"
                            >
                            <div class="dest-card-gradient"></div>
                            <span class="dest-region-pill">Rajasthan</span>
                        </div>
                        <div class="dest-card-info">
                            <h3 class="dest-name">Udaipur</h3>
                            <p class="dest-story">Marble courtyards mirrored in tranquil lake waters and regal silence.</p>
                            <span class="dest-cta-link">
                                Discover Udaipur <i class="fa-solid fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>

                    <!-- Dest 2: Goa -->
                    <a href="/listings?search=Goa" class="dest-showcase-card anim-stagger-card" style="--stagger-idx: 1;">
                        <div class="dest-card-media">
                            <img 
                                src="https://images.unsplash.com/photo-1512343879784-a960bf40e7f2?auto=format&fit=crop&w=800&q=85" 
                                alt="Goa Coastal Sanctuaries" 
                                loading="lazy"
                                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=80';"
                                class="parallax-media-img"
                            >
                            <div class="dest-card-gradient"></div>
                            <span class="dest-region-pill">Coastal Haven</span>
                        </div>
                        <div class="dest-card-info">
                            <h3 class="dest-name">Goa</h3>
                            <p class="dest-story">Palm-shaded Portuguese estates, golden shores, and unhurried afternoons.</p>
                            <span class="dest-cta-link">
                                Discover Goa <i class="fa-solid fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>

                    <!-- Dest 3: Manali -->
                    <a href="/listings?search=Manali" class="dest-showcase-card anim-stagger-card" style="--stagger-idx: 2;">
                        <div class="dest-card-media">
                            <img 
                                src="https://images.unsplash.com/photo-1626621341517-bbf3d9990a23?auto=format&fit=crop&w=800&q=85" 
                                alt="Manali Alpine Cedar Forests" 
                                loading="lazy"
                                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=800&q=80';"
                                class="parallax-media-img"
                            >
                            <div class="dest-card-gradient"></div>
                            <span class="dest-region-pill">Himachal</span>
                        </div>
                        <div class="dest-card-info">
                            <h3 class="dest-name">Manali</h3>
                            <p class="dest-story">Glacial rivers, cedar chalets, and crisp mountain breeze across the valley.</p>
                            <span class="dest-cta-link">
                                Discover Manali <i class="fa-solid fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>

                    <!-- Dest 4: Leh -->
                    <a href="/listings?search=Leh" class="dest-showcase-card anim-stagger-card" style="--stagger-idx: 3;">
                        <div class="dest-card-media">
                            <img 
                                src="https://images.unsplash.com/photo-1581793745862-99fde7fa73d2?auto=format&fit=crop&w=800&q=85" 
                                alt="Leh Ladakh Valleys" 
                                loading="lazy"
                                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80';"
                                class="parallax-media-img"
                            >
                            <div class="dest-card-gradient"></div>
                            <span class="dest-region-pill">Ladakh</span>
                        </div>
                        <div class="dest-card-info">
                            <h3 class="dest-name">Leh</h3>
                            <p class="dest-story">Monastic tranquility, starlit dark skies, and high-altitude mountain passes.</p>
                            <span class="dest-cta-link">
                                Discover Leh <i class="fa-solid fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>

                    <!-- Dest 5: Munnar -->
                    <a href="/listings?search=Munnar" class="dest-showcase-card anim-stagger-card" style="--stagger-idx: 4;">
                        <div class="dest-card-media">
                            <img 
                                src="https://images.unsplash.com/photo-1596176530529-78163a4f7af2?auto=format&fit=crop&w=800&q=85" 
                                alt="Munnar Tea Plantations" 
                                loading="lazy"
                                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=800&q=80';"
                                class="parallax-media-img"
                            >
                            <div class="dest-card-gradient"></div>
                            <span class="dest-region-pill">Kerala</span>
                        </div>
                        <div class="dest-card-info">
                            <h3 class="dest-name">Munnar</h3>
                            <p class="dest-story">Rolling emerald tea estates shrouded in mist and birdsong at daybreak.</p>
                            <span class="dest-cta-link">
                                Discover Munnar <i class="fa-solid fa-arrow-right ms-1"></i>
                            </span>
                        </div>
                    </a>
                </div>
            </div>
        </section>

        <!-- ==========================================================================
             SECTION 3: "WHY ROAMLY" SECTION (Trusted Stays, Meaningful Travel, Seamless Discovery)
             ========================================================================== -->
        <section class="cinematic-section why-roamly-section" id="whyRoamlySection">
            <div class="editorial-container">
                <div class="why-roamly-split-layout">
                    <!-- Left Column: Editorial Statement -->
                    <div class="why-statement-col reveal-item">
                        <span class="editorial-tag"><i class="fa-solid fa-seedling me-1"></i> The Roamly Ethos</span>
                        <h2 class="why-main-heading anim-text-split">
                            <span class="word-reveal">We</span> 
