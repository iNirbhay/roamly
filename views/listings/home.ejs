</div>

<!-- ==========================================================================
     CINEMATIC INTERACTION ENGINE (Parallax, Morph, Scroll Zoom, Reveals)
     ========================================================================== -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const heroStage = document.getElementById("heroStage");
        const heroBack = document.getElementById("heroLayerBack");
        const heroMid = document.getElementById("heroLayerMid");
        const heroMist = document.getElementById("heroLayerMist");
        const heroBrandMorph = document.getElementById("heroBrandMorph");
        const heroLogoPanel = document.getElementById("heroLogoPanel");
        const heroHeadPanel = document.getElementById("heroHeadPanel");
        const heroSearchCapsule = document.getElementById("heroSearchCapsule");
        const heroScrollPrompt = document.getElementById("heroScrollPrompt");
        const scrollProgressLine = document.getElementById("scrollProgressLine");
        const parallaxImages = document.querySelectorAll(".parallax-media-img");

        // 1. OPENING SEQUENCE: Logo reveal morphing into Headline
        setTimeout(() => {
            if (heroLogoPanel && heroHeadPanel) {
                heroLogoPanel.classList.add("fade-out-morph");
                setTimeout(() => {
                    heroLogoPanel.style.display = "none";
                    heroHeadPanel.classList.add("revealed-headline");
                }, 850);
            }
        }, 2000);

        // 2. SMOOTH SCROLL PROGRESS & PARALLAX ENGINE
        let ticking = false;
        const handleScroll = () => {
            const scrollY = window.pageYOffset || document.documentElement.scrollTop;
            const heroHeight = heroStage ? heroStage.offsetHeight : 800;

            // Update Top Progress Bar
            if (scrollProgressLine) {
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const progressPct = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;
                scrollProgressLine.style.width = `${Math.min(100, Math.max(0, progressPct))}%`;
            }

            // Hero depth camera zoom
            if (scrollY <= heroHeight * 1.5) {
                const progress = Math.min(scrollY / heroHeight, 1);
                
                if (heroBack) {
                    heroBack.style.transform = `scale(${1 + progress * 0.14}) translate3d(0, ${scrollY * 0.28}px, 0)`;
                }
                if (heroMid) {
                    heroMid.style.transform = `scale(${1 + progress * 0.08}) translate3d(0, ${scrollY * 0.15}px, 0)`;
                }
                if (heroMist) {
                    heroMist.style.opacity = `${Math.max(0, 1 - progress * 0.9)}`;
                }
                if (heroBrandMorph) {
                    heroBrandMorph.style.transform = `translate3d(0, ${scrollY * 0.35}px, 0)`;
                    heroBrandMorph.style.opacity = `${Math.max(0, 1 - progress * 1.35)}`;
                }
                if (heroSearchCapsule) {
                    heroSearchCapsule.style.transform = `translate3d(0, ${scrollY * 0.18}px, 0)`;
                    heroSearchCapsule.style.opacity = `${Math.max(0, 1 - progress * 1.5)}`;
                }
                if (heroScrollPrompt) {
                    heroScrollPrompt.style.opacity = `${Math.max(0, 1 - progress * 3)}`;
                }
            }

            // Continuous Card Media Parallax
            const windowH = window.innerHeight;
            parallaxImages.forEach(img => {
                const rect = img.getBoundingClientRect();
                if (rect.top < windowH && rect.bottom > 0) {
                    const centerOffset = (rect.top + rect.height / 2) - (windowH / 2);
                    const translateY = (centerOffset * 0.07).toFixed(1);
                    img.style.transform = `translate3d(0, ${translateY}px, 0) scale(1.08)`;
                }
            });

            ticking = false;
        };

        window.addEventListener("scroll", () => {
            if (!ticking) {
                window.requestAnimationFrame(handleScroll);
                ticking = true;
            }
        }, { passive: true });

        // Initial call for scroll position
        handleScroll();

        // 3. PROGRESSIVE SECTION REVEALS & STAGGER GROUPS (IntersectionObserver)
        const revealTargets = document.querySelectorAll(".reveal-item, .reveal-stagger-group");
        if ("IntersectionObserver" in window) {
            const observerOptions = {
                root: null,
                threshold: 0.08,
                rootMargin: "0px 0px -40px 0px"
            };

            const revealObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("is-visible");
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            revealTargets.forEach(item => revealObserver.observe(item));
        } else {
            revealTargets.forEach(item => item.classList.add("is-visible"));
        }

        // Safety fallback: reveal above-fold elements immediately
        setTimeout(() => {
            revealTargets.forEach(item => {
                const rect = item.getBoundingClientRect();
                if (rect.top < window.innerHeight * 1.2) {
                    item.classList.add("is-visible");
                }
            });
        }, 500);

        // 4. DESTINATION CARDS PERSPECTIVE 3D HOVER TILT
        const destCards = document.querySelectorAll(".dest-showcase-card");
        destCards.forEach(card => {
            card.addEventListener("mousemove", (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;
                const rotateX = ((y - centerY) / centerY) * -6;
                const rotateY = ((x - centerX) / centerX) * 6;

                card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
            });

            card.addEventListener("mouseleave", () => {
                card.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)`;
            });
        });

        // 5. CINEMATIC SEARCH PILL CONTROLLER (DESTINATION, CALENDAR, GUESTS)
        const segDest = document.getElementById("segDestTrigger");
        const segDates = document.getElementById("segDatesTrigger");
        const segGuests = document.getElementById("segGuestsTrigger");

        const destPopover = document.getElementById("destPopover");
        const calendarPopover = document.getElementById("calendarPopover");
        const guestsPopover = document.getElementById("guestsPopover");

        const searchDestInput = document.getElementById("searchDestinationInput");
        const datesDisplayText = document.getElementById("datesDisplayText");
        const guestsDisplayText = document.getElementById("guestsDisplayText");
        const hiddenCheckIn = document.getElementById("hiddenCheckIn");
        const hiddenCheckOut = document.getElementById("hiddenCheckOut");
        const hiddenGuests = document.getElementById("hiddenGuests");

        const closeAllPopovers = () => {
            if (destPopover) destPopover.classList.add("d-none");
            if (calendarPopover) calendarPopover.classList.add("d-none");
            if (guestsPopover) guestsPopover.classList.add("d-none");
            if (segDest) segDest.classList.remove("active-seg");
            if (segDates) segDates.classList.remove("active-seg");
            if (segGuests) segGuests.classList.remove("active-seg");
        };

        const togglePopover = (popover, seg) => {
            const isCurrentlyOpen = popover && !popover.classList.contains("d-none");
            closeAllPopovers();
            if (!isCurrentlyOpen && popover) {
                popover.classList.remove("d-none");
                if (seg) seg.classList.add("active-seg");
            }
        };

        if (segDest) {
            segDest.addEventListener("click", (e) => {
                togglePopover(destPopover, segDest);
                if (searchDestInput) searchDestInput.focus();
            });
        }

        if (searchDestInput) {
            searchDestInput.addEventListener("focus", () => {
                if (destPopover) {
                    closeAllPopovers();
                    destPopover.classList.remove("d-none");
                    if (segDest) segDest.classList.add("active-seg");
                }
            });
            searchDestInput.addEventListener("click", (e) => {
                e.stopPropagation();
            });
        }

        if (segDates) {
            segDates.addEventListener("click", (e) => {
                e.stopPropagation();
                togglePopover(calendarPopover, segDates);
            });
        }

        if (segGuests) {
            segGuests.addEventListener("click", (e) => {
                e.stopPropagation();
                togglePopover(guestsPopover, segGuests);
            });
        }

        // Suggested Destinations Click Handler
        const destItems = document.querySelectorAll(".dest-suggest-item");
        destItems.forEach(item => {
            item.addEventListener("click", (e) => {
                e.stopPropagation();
                const place = item.getAttribute("data-place");
                if (searchDestInput && place) {
                    searchDestInput.value = place;
                }
                closeAllPopovers();
                // Open dates calendar next for seamless flow
                if (calendarPopover && segDates) {
                    setTimeout(() => togglePopover(calendarPopover, segDates), 150);
                }
            });
        });

        // Close on Click Outside
        document.addEventListener("click", (e) => {
            if (!e.target.closest("#heroSearchCapsule")) {
                closeAllPopovers();
            }
        });

        // Interactive Calendar Engine
        const calMonthTitle = document.getElementById("calMonthTitle");
        const calDaysGrid = document.getElementById("calDaysGrid");
        const calPrevBtn = document.getElementById("calPrevBtn");
        const calNextBtn = document.getElementById("calNextBtn");
        const calSummaryPill = document.getElementById("calSummaryPill");
        const calDoneBtn = document.getElementById("calDoneBtn");

        const monthNames = [
            "January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"
        ];

        const today = new Date();
        today.setHours(0, 0, 0, 0);

        let viewYear = today.getFullYear();
        let viewMonth = today.getMonth();

        let selectedStartDate = null;
        let selectedEndDate = null;

        const formatShortDate = (d) => {
            const m = monthNames[d.getMonth()].slice(0, 3);
            return `${m} ${d.getDate()}`;
        };

        const formatFullInputDate = (d) => {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        };

        const updateDateDisplays = () => {
            if (selectedStartDate && selectedEndDate) {
                const diffTime = Math.abs(selectedEndDate - selectedStartDate);
                const nights = Math.max(1, Math.round(diffTime / (1000 * 60 * 60 * 24)));
                const text = `${formatShortDate(selectedStartDate)} – ${formatShortDate(selectedEndDate)} (${nights} night${nights > 1 ? 's' : ''})`;
                if (datesDisplayText) datesDisplayText.textContent = text;
                if (calSummaryPill) calSummaryPill.textContent = text;
                if (hiddenCheckIn) hiddenCheckIn.value = formatFullInputDate(selectedStartDate);
                if (hiddenCheckOut) hiddenCheckOut.value = formatFullInputDate(selectedEndDate);
            } else if (selectedStartDate) {
                const text = `From ${formatShortDate(selectedStartDate)}`;
                if (datesDisplayText) datesDisplayText.textContent = text;
                if (calSummaryPill) calSummaryPill.textContent = "Select checkout date";
                if (hiddenCheckIn) hiddenCheckIn.value = formatFullInputDate(selectedStartDate);
                if (hiddenCheckOut) hiddenCheckOut.value = "";
            } else {
                if (datesDisplayText) datesDisplayText.textContent = "Add flexible dates";
                if (calSummaryPill) calSummaryPill.textContent = "Select check-in date";
                if (hiddenCheckIn) hiddenCheckIn.value = "";
                if (hiddenCheckOut) hiddenCheckOut.value = "";
            }
        };

        const renderCalendar = () => {
            if (!calDaysGrid || !calMonthTitle) return;
            calMonthTitle.textContent = `${monthNames[viewMonth]} ${viewYear}`;

            if (calPrevBtn) {
                const isPast = (viewYear < today.getFullYear()) || (viewYear === today.getFullYear() && viewMonth <= today.getMonth());
                calPrevBtn.disabled = isPast;
                calPrevBtn.style.opacity = isPast ? "0.3" : "1";
                calPrevBtn.style.cursor = isPast ? "not-allowed" : "pointer";
            }

            calDaysGrid.innerHTML = "";

            const firstDayIndex = new Date(viewYear, viewMonth, 1).getDay();
            const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

            for (let i = 0; i < firstDayIndex; i++) {
                const emptyCell = document.createElement("div");
                emptyCell.className = "cal-empty-cell";
                calDaysGrid.appendChild(emptyCell);
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const dayDate = new Date(viewYear, viewMonth, day);
                dayDate.setHours(0, 0, 0, 0);

                const cell = document.createElement("button");
                cell.type = "button";
                cell.className = "cal-day-cell";
                cell.textContent = day;

                const isPastDay = dayDate < today;
                if (isPastDay) {
                    cell.classList.add("disabled");
                    cell.disabled = true;
                } else {
                    const time = dayDate.getTime();
                    const startTime = selectedStartDate ? selectedStartDate.getTime() : null;
                    const endTime = selectedEndDate ? selectedEndDate.getTime() : null;

                    if (startTime && time === startTime) {
                        cell.classList.add("selected-start");
                    } else if (endTime && time === endTime) {
                        cell.classList.add("selected-end");
                    } else if (startTime && endTime && time > startTime && time < endTime) {
                        cell.classList.add("in-range");
                    }

                    cell.addEventListener("click", (e) => {
                        e.stopPropagation();
                        if (!selectedStartDate || (selectedStartDate && selectedEndDate)) {
                            selectedStartDate = new Date(dayDate);
                            selectedEndDate = null;
                        } else if (selectedStartDate && !selectedEndDate) {
                            if (dayDate > selectedStartDate) {
                                selectedEndDate = new Date(dayDate);
                            } else {
                                selectedStartDate = new Date(dayDate);
                                selectedEndDate = null;
                            }
                        }
                        updateDateDisplays();
                        renderCalendar();
                    });
                }

                calDaysGrid.appendChild(cell);
            }
        };

        if (calPrevBtn) {
            calPrevBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                viewMonth--;
                if (viewMonth < 0) {
                    viewMonth = 11;
                    viewYear--;
                }
                renderCalendar();
            });
        }

        if (calNextBtn) {
            calNextBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                viewMonth++;
                if (viewMonth > 11) {
                    viewMonth = 0;
                    viewYear++;
                }
                renderCalendar();
            });
        }

        if (calDoneBtn) {
            calDoneBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                closeAllPopovers();
            });
        }

        // Quick date shortcuts
        const shortcutWeekend = document.getElementById("shortcutWeekend");
        const shortcutWeek = document.getElementById("shortcutWeek");
        const shortcutReset = document.getElementById("shortcutReset");

        if (shortcutWeekend) {
            shortcutWeekend.addEventListener("click", (e) => {
                e.stopPropagation();
                const now = new Date();
                const dayOfWeek = now.getDay();
                const daysUntilFriday = (5 - dayOfWeek + 7) % 7 || 7;
                const friday = new Date(now.getFullYear(), now.getMonth(), now.getDate() + daysUntilFriday);
                const sunday = new Date(friday.getFullYear(), friday.getMonth(), friday.getDate() + 2);
                selectedStartDate = friday;
                selectedEndDate = sunday;
                viewYear = friday.getFullYear();
                viewMonth = friday.getMonth();
                updateDateDisplays();
                renderCalendar();
            });
        }

        if (shortcutWeek) {
            shortcutWeek.addEventListener("click", (e) => {
                e.stopPropagation();
                const now = new Date();
                const start = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
                const end = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 8);
                selectedStartDate = start;
                selectedEndDate = end;
                viewYear = start.getFullYear();
                viewMonth = start.getMonth();
                updateDateDisplays();
                renderCalendar();
            });
        }

        if (shortcutReset) {
            shortcutReset.addEventListener("click", (e) => {
                e.stopPropagation();
                selectedStartDate = null;
                selectedEndDate = null;
                updateDateDisplays();
                renderCalendar();
            });
        }

        // Initialize Calendar
        renderCalendar();

        // Guests Counter Engine
        let adultsCount = 2;
        let childrenCount = 0;
        let infantsCount = 0;

        const valAdults = document.getElementById("valAdults");
        const valChildren = document.getElementById("valChildren");
        const valInfants = document.getElementById("valInfants");

        const btnAdultDec = document.getElementById("btnAdultDec");
        const btnAdultInc = document.getElementById("btnAdultInc");
        const btnChildDec = document.getElementById("btnChildDec");
        const btnChildInc = document.getElementById("btnChildInc");
        const btnInfantDec = document.getElementById("btnInfantDec");
        const btnInfantInc = document.getElementById("btnInfantInc");
        const guestsDoneBtn = document.getElementById("guestsDoneBtn");

        const updateGuestsDisplay = () => {
            if (valAdults) valAdults.textContent = adultsCount;
            if (valChildren) valChildren.textContent = childrenCount;
            if (valInfants) valInfants.textContent = infantsCount;

            if (btnAdultDec) btnAdultDec.disabled = adultsCount <= 1;
            if (btnChildDec) btnChildDec.disabled = childrenCount <= 0;
            if (btnInfantDec) btnInfantDec.disabled = infantsCount <= 0;

            const totalTravelers = adultsCount + childrenCount;
            let text = `${totalTravelers} conscious traveler${totalTravelers > 1 ? 's' : ''}`;
            if (infantsCount > 0) {
                text += `, ${infantsCount} infant${infantsCount > 1 ? 's' : ''}`;
            }

            if (guestsDisplayText) guestsDisplayText.textContent = text;
            if (hiddenGuests) hiddenGuests.value = totalTravelers;
        };

        if (btnAdultDec) {
            btnAdultDec.addEventListener("click", (e) => {
                e.stopPropagation();
                if (adultsCount > 1) {
                    adultsCount--;
                    updateGuestsDisplay();
                }
            });
        }
        if (btnAdultInc) {
            btnAdultInc.addEventListener("click", (e) => {
                e.stopPropagation();
                if (adultsCount < 16) {
                    adultsCount++;
                    updateGuestsDisplay();
                }
            });
        }
        if (btnChildDec) {
            btnChildDec.addEventListener("click", (e) => {
                e.stopPropagation();
                if (childrenCount > 0) {
                    childrenCount--;
                    updateGuestsDisplay();
                }
            });
        }
        if (btnChildInc) {
            btnChildInc.addEventListener("click", (e) => {
                e.stopPropagation();
                if (childrenCount < 10) {
                    childrenCount++;
                    updateGuestsDisplay();
                }
            });
        }
        if (btnInfantDec) {
            btnInfantDec.addEventListener("click", (e) => {
                e.stopPropagation();
                if (infantsCount > 0) {
                    infantsCount--;
                    updateGuestsDisplay();
                }
            });
        }
        if (btnInfantInc) {
            btnInfantInc.addEventListener("click", (e) => {
                e.stopPropagation();
                if (infantsCount < 5) {
                    infantsCount++;
                    updateGuestsDisplay();
                }
            });
        }
        if (guestsDoneBtn) {
            guestsDoneBtn.addEventListener("click", (e) => {
                e.stopPropagation();
                closeAllPopovers();
            });
        }

        updateGuestsDisplay();
    });
</script>
