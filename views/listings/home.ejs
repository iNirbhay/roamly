                    }
                    if (curatedThree.length > 0) { 
                        curatedThree.forEach((stay, idx) => { 
                    %>
                        <div class="featured-stay-card anim-stagger-card" style="--stagger-idx: <%= idx %>;">
                            <a href="/listings/<%= stay._id %>" class="featured-stay-anchor">
