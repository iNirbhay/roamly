                                        src="<%= typeof resolveListingImage === 'function' ? resolveListingImage(stay) : (stay.imageUrl || 'https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80') %>" 
                                        alt="<%= stay.title %>" 
                                        loading="lazy"
                                        onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=800&q=80';"
