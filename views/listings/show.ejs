        if (window.ListingLocationMap) {
            window.ListingLocationMap.init({
                containerId: "propertyLocationMap",
                attractionsContainerId: "nearbyAttractionsList",
                listing: {
                    _id: "<%= listing._id %>",
                    title: <%- JSON.stringify(listing.title) %>,
                    location: <%- JSON.stringify(listing.location || '') %>,
                    country: <%- JSON.stringify(listing.country || 'India') %>,
                    price: <%= listing.price || 0 %>,
                    imageUrl: <%- JSON.stringify(typeof resolveListingImage === 'function' ? resolveListingImage(listing) : (listing.imageUrl || '')) %>
                }
            });
        }
    });
</script>
